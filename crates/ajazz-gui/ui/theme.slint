export global Theme {
    // Paleta Monocromática Grafite Neutro
    in-out property <color> background: #18181B;
    in-out property <color> surface: #222227;
    in-out property <color> surface-raised: #28282F;
    in-out property <color> surface-hover: #2B2B33;
    in-out property <color> surface-active: #35353F;
    in-out property <color> border: #32323A;
    in-out property <color> border-light: #42424C;

    // Tipografia
    in-out property <color> text-primary: #F4F4F5;
    in-out property <color> text-secondary: #A1A1AA;
    in-out property <color> text-muted: #71717A;
    in-out property <string> mono-font: "JetBrains Mono";

    // Cores Funcionais (Evidência e Telemetria Apenas)
    in-out property <color> status-online: #22C55E;
    in-out property <color> status-warning: #EAB308;
    in-out property <color> status-error: #EF4444;

    // Métricas Geométricas
    in-out property <length> radius-sm: 4px;
    in-out property <length> radius-md: 6px;
    in-out property <length> radius-lg: 8px;
}
