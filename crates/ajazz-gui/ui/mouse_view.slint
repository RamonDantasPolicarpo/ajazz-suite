            // Painel Direito: Editor do Slot Selecionado
            Rectangle {
                width: 460px;
                height: 520px;
                background: Theme.surface;
                border-radius: Theme.radius-lg;
                border-color: Theme.border;
                border-width: 1px;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    // Cabeçalho do Slot Selecionado
                    HorizontalLayout {
                        alignment: space-between;
                        Rectangle {
                            height: 24px;
                            width: 158px;
                            border-radius: Theme.radius-sm;
                            background: Theme.surface-active;
                            border-color: Theme.border-light;
                            border-width: 1px;
