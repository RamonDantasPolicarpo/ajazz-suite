import { Theme } from "theme.slint";

export struct MouseChatterRowItem {
    button-name: string,
    total-clicks: int,
    chatter-count: int,
    last-ms: string,
    min-ms: string,
    has-chatter: bool,
}

component MousePill inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <bool> highlight: false;
    in property <length> pill-width: 72px;
    in property <length> pill-height: 24px;
    callback clicked();

    width: root.pill-width;
    height: root.pill-height;
    border-radius: Theme.radius-sm;
    background: !root.enabled
        ? Theme.background
        : (root.highlight ? #1F3A2A : (root.active ? Theme.surface-active : (ta.has-hover ? Theme.surface-hover : Theme.surface-raised)));
    border-color: root.highlight && root.enabled
        ? Theme.status-online
        : (root.active && root.enabled ? Theme.border-light : Theme.border);
    border-width: 1px;
    opacity: root.enabled ? 1.0 : 0.4;

    Text {
        width: parent.width - 10px;
        x: 5px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        font-family: Theme.mono-font;
        font-size: 9px;
        font-weight: root.active || root.highlight ? 700 : 500;
        color: root.highlight && root.enabled ? Theme.status-online : (root.active ? Theme.text-primary : Theme.text-secondary);
        horizontal-alignment: center;
        overflow: elide;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component MouseSubTab inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active: false;
    in property <length> tab-width: 136px;
    callback clicked();

    width: root.tab-width;
    height: 24px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.surface-active : (ta.has-hover ? Theme.surface-hover : Theme.surface);
    border-color: root.active ? Theme.border-light : Theme.border;
    border-width: 1px;

    HorizontalLayout {
        spacing: 5px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 11px;
                height: 11px;
                colorize: root.active ? Theme.text-primary : Theme.text-secondary;
            }
        }

        Text {
            text: root.label;
            font-family: Theme.mono-font;
            font-size: 9px;
            font-weight: root.active ? 700 : 500;
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component MouseSlotChip inherits Rectangle {
    in property <int> slot-num;
    in property <string> slot-name;
    in property <string> binding-label;
    in property <bool> selected: false;
    callback clicked();

    height: 18px;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.surface-active : (ta.has-hover ? Theme.surface-hover : Theme.surface);
    border-color: root.selected ? Theme.text-primary : Theme.border;
    border-width: 1px;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 5px;
        alignment: space-between;

        Text {
            text: "[" + root.slot-num + "] " + root.slot-name;
            font-family: Theme.mono-font;
            font-size: 8px;
            font-weight: 700;
            color: root.selected ? Theme.text-primary : Theme.text-muted;
            vertical-alignment: center;
        }

        Text {
            text: root.binding-label;
            font-family: Theme.mono-font;
            font-size: 8px;
            font-weight: 600;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MouseView inherits Rectangle {
    in property <bool> daemon-online: false;
    in property <bool> ms-connected: false;
    in property <bool> ms-online: false;
    in property <bool> ms-charging: false;
    in property <int> ms-battery-percent: 0;
    in property <string> ms-conn-label: "OFFLINE";
    in property <string> ms-fw-label: "VID 0x7768 • UsagePage 0xFFB2";
    in property <string> ms-feedback-text: "";
    in property <bool> ms-feedback-is-error: false;

    in-out property <int> subtab: 0; // 0=Performance, 1=Botões, 2=Energia, 3=Diagnóstico
    in property <bool> dirty: false;

    // Switch Chattering (Diagnóstico ao vivo)
    in property <bool> chatter-enabled: true;
    in property <int> chatter-threshold-ms: 45;
    in property <int> chatter-total: 0;
    in property <string> chatter-alert-text: "Nenhum rebote anormal detectado nos switches físicos.";
    in property <[MouseChatterRowItem]> chatter-rows: [];

    // Performance & Sensor
    in property <int> dpi-count: 4;
    in property <int> dpi-index: 1;
    in property <[int]> dpi-values: [400, 800, 1600, 3200, 6400, 12800];
    in property <[string]> dpi-texts: ["400", "800", "1600", "3200", "6400", "12800"];
    in property <int> polling-idx: 3;
    in property <int> lod-idx: 0;
    in property <bool> motion-sync: true;
    in property <bool> ripple-control: false;
    in property <bool> linear-correction: false;
    in property <bool> highspeed-mode: true;
    in property <int> debounce-ms: 8;

    // Energia & Conexão
    in property <int> scroll-idx: 0;
    in property <int> light-sleep: 60;
    in property <int> deep-sleep: 300;
    in property <string> light-sleep-label: "1 min";
    in property <string> deep-sleep-label: "5 min";
    property <bool> confirm-pairing: false;

    // Botões (5 slots)
    in property <[string]> button-labels: ["Clique Esq.", "Clique Dir.", "Botão Meio", "Avançar", "Voltar"];
    in property <int> selected-slot: 0;
    in property <string> slot-title: "[0] CLIQUE ESQUERDO";
    in property <string> slot-current-binding: "Clique Esq.";
    in-out property <int> btn-category: 0;
    in-out property <int> btn-mouse-idx: 0;
    in-out property <int> btn-mod-mask: 0;
    in-out property <int> btn-key-idx: 0;
    in-out property <int> btn-media-idx: 0;
    in-out property <int> btn-system-idx: 0;
    in-out property <int> btn-macro-idx: 0;
    in-out property <int> btn-macro-mode: 0; // 0=N vezes, 1=Até soltar, 2=Alternar
    in-out property <int> btn-macro-repeat: 1;
    in-out property <bool> btn-capturing-key: false;
    in property <bool> btn-left-warning: false;
    in property <[string]> key-catalog-labels: [];
    in property <[string]> media-labels: [];
    in property <[string]> macro-names: [];

    // Callbacks Performance & Sensor + Gerais
    callback dpi-count-changed(int);
    callback dpi-stage-selected(int);
    callback dpi-step(int, int);
    callback dpi-text-edited(int, string);
    callback dpi-text-committed(int, string);
    callback polling-selected(int);
    callback lod-selected(int);
    callback sensor-toggled(int);
    callback highspeed-toggled();
    callback debounce-step(int);
    callback debounce-set(int);
    callback scroll-selected(int);
    callback light-sleep-selected(int);
    callback deep-sleep-selected(int);
    callback apply-config-clicked();
    callback sync-clicked();
    callback start-pairing-clicked();

    // Callbacks Botões
    callback slot-selected(int);
    callback btn-category-selected(int);
    callback btn-mouse-selected(int);
    callback btn-toggle-modifier(int);
    callback btn-catalog-key-selected(int);
    callback btn-capture-key(string, bool, bool, bool, bool);
    callback btn-media-selected(int);
    callback btn-system-selected(int);
    callback btn-macro-selected(int);
    callback btn-macro-mode-selected(int);
    callback btn-macro-repeat-step(int);
    callback open-macro-editor-clicked();
    callback apply-button-clicked();
    callback reset-buttons-clicked();

    // Callbacks Switch Chattering
    callback chatter-toggle-clicked();
    callback chatter-threshold-step(int);
    callback chatter-reset-clicked();

    background: Theme.background;

    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        alignment: start;

        // Cabeçalho & Telemetria ao vivo
        HorizontalLayout {
            width: 720px;
            alignment: space-between;

            VerticalLayout {
                spacing: 2px;
                alignment: center;
                Text {
                    text: "AJAZZ AJ179 NL P NEARLINK";
                    font-family: Theme.mono-font;
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.text-primary;
                }
                Text {
                    width: 390px;
                    text: root.ms-feedback-text != "" ? root.ms-feedback-text : root.ms-fw-label;
                    font-family: Theme.mono-font;
                    font-size: 9px;
                    color: root.ms-feedback-is-error
                        ? Theme.status-error
                        : (root.ms-feedback-text != "" ? Theme.status-online : Theme.text-secondary);
                    overflow: elide;
                }
            }

            // Badge de Conexão + Bateria
            Rectangle {
                height: 26px;
                border-radius: Theme.radius-sm;
                background: Theme.surface;
                border-color: Theme.border;
                border-width: 1px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: !root.daemon-online
                                ? Theme.status-error
                                : (root.ms-connected && root.ms-online ? Theme.status-online : Theme.status-warning);
                        }
                    }

                    if (root.daemon-online && root.ms-connected) : VerticalLayout {
                        alignment: center;
                        Image {
                            source: root.ms-conn-label == "USB WIRED"
                                ? @image-url("assets/icon_usb.svg")
                                : @image-url("assets/icon_wireless.svg");
                            width: 12px;
                            height: 12px;
                            colorize: root.ms-online ? Theme.text-primary : Theme.status-warning;
                        }
                    }

                    Text {
                        text: root.daemon-online ? root.ms-conn-label : "DAEMON OFF";
                        font-family: Theme.mono-font;
                        font-size: 9px;
                        font-weight: 700;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    if (root.ms-connected) : HorizontalLayout {
                        spacing: 5px;
                        alignment: center;

                        Text {
                            text: "•";
                            font-family: Theme.mono-font;
                            font-size: 9px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 22px;
                                height: 12px;

                                Rectangle {
                                    x: 2.5px;
                                    y: 2.5px;
                                    height: 7px;
                                    width: 13.5px * (clamp(root.ms-battery-percent, 0, 100) / 100.0);
                                    border-radius: 1px;
                                    background: root.ms-battery-percent > 20 ? Theme.status-online : Theme.status-error;
                                }

                                Image {
                                    source: @image-url("assets/icon_battery.svg");
                                    width: 22px;
                                    height: 12px;
                                    colorize: Theme.border-light;
                                }
                            }
                        }

                        Text {
                            text: root.ms-battery-percent + "%";
                            font-family: Theme.mono-font;
                            font-size: 9px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }

                        if (root.ms-charging) : VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("assets/icon_lightning.svg");
                                width: 12px;
                                height: 12px;
                                colorize: Theme.status-warning;
                            }
                        }
                    }

                    if (root.chatter-total > 0) : Rectangle {
                        width: 112px;
                        height: 22px;
                        border-radius: Theme.radius-sm;
                        background: #3A1C1C;
                        border-color: Theme.status-error;
                        border-width: 1px;

                        Text {
                            text: "CHATTER: " + root.chatter-total;
                            font-family: Theme.mono-font;
                            font-size: 9px;
                            font-weight: 700;
                            color: Theme.status-error;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        TouchArea {
                            clicked => { root.subtab = 3; }
                        }
                    }
                }
            }
        }

        // Sub-abas + Ações Globais (Sincronizar / Aplicar no Mouse)
        HorizontalLayout {
            width: 720px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 4px;
                MouseSubTab {
                    label: "PERFORMANCE";
                    icon: @image-url("assets/icon_perf.svg");
                    tab-width: 118px;
                    active: root.subtab == 0;
                    clicked => { root.subtab = 0; }
                }
                MouseSubTab {
                    label: "BOTÕES (5)";
                    icon: @image-url("assets/icon_buttons.svg");
                    tab-width: 96px;
                    active: root.subtab == 1;
                    clicked => { root.subtab = 1; }
                }
                MouseSubTab {
                    label: "ENERGIA & 2.4G";
                    icon: @image-url("assets/icon_power.svg");
                    tab-width: 120px;
                    active: root.subtab == 2;
                    clicked => { root.subtab = 2; }
                }
                MouseSubTab {
                    label: root.chatter-total > 0 ? "DIAGNÓSTICO (" + root.chatter-total + ")" : "DIAGNÓSTICO";
                    icon: @image-url("assets/icon_diag.svg");
                    tab-width: 130px;
                    active: root.subtab == 3;
                    clicked => { root.subtab = 3; }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                MousePill {
                    text: "SINCRONIZAR";
                    pill-width: 96px;
                    enabled: root.ms-connected;
                    clicked => { root.sync-clicked(); }
                }
                MousePill {
                    text: root.dirty ? "* APLICAR NO MOUSE" : "APLICAR NO MOUSE";
                    pill-width: 134px;
                    enabled: root.ms-connected;
                    highlight: root.dirty;
                    clicked => { root.apply-config-clicked(); }
                }
            }
        }

        // ============================================================
        // SUB-ABA 0: PERFORMANCE & SENSOR
        // ============================================================
        if (root.subtab == 0) : VerticalLayout {
            spacing: 10px;
            width: 720px;

            // Card 1: Estágios de DPI (6 slots, 50..26000)
            Rectangle {
                width: 720px;
                height: 264px;
                background: Theme.surface;
                border-radius: Theme.radius-lg;
                border-color: Theme.border;
                border-width: 1px;

                VerticalLayout {
                    padding: 14px;
                    spacing: 7px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "ESTÁGIOS DE DPI (50 - 26.000, PASSO 50)";
                            font-family: Theme.mono-font;
                            font-size: 9px;
                            font-weight: 700;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Estágios ativos:";
                                font-family: Theme.mono-font;
                                font-size: 9px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                            for cnt in 6 : MousePill {
                                text: "" + (cnt + 1);
                                pill-width: 24px;
                                pill-height: 20px;
                                active: root.dpi-count == (cnt + 1);
                                clicked => { root.dpi-count-changed(cnt + 1); }
                            }
                        }
                    }

                    for idx in 6 : HorizontalLayout {
                        height: 28px;
                        spacing: 8px;
                        opacity: idx < root.dpi-count ? 1.0 : 0.35;

                        property <color> stage-color: idx == 0 ? #EF4444
                            : (idx == 1 ? #22C55E
                            : (idx == 2 ? #3B82F6
                            : (idx == 3 ? #06B6D4
                            : (idx == 4 ? #EAB308 : #EC4899))));
                        property <bool> is-active: root.dpi-index == idx;

                        // Botão seletor de estágio ativo com bolinha colorida fixa + ponto branco no ativo
                        Rectangle {
                            width: 52px;
                            height: 24px;
                            border-radius: Theme.radius-sm;
                            background: is-active
                                ? #1F3A2A
                                : (ta-stage.has-hover ? Theme.surface-hover : Theme.surface-raised);
                            border-color: is-active ? Theme.status-online : Theme.border;
                            border-width: 1px;

                            HorizontalLayout {
                                spacing: 5px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 5px;
                                        background: stage-color;

                                        if (is-active) : Rectangle {
                                            width: 4px;
                                            height: 4px;
                                            x: 3px;
                                            y: 3px;
                                            border-radius: 2px;
                                            background: #FFFFFF;
                                        }
                                    }
                                }

                                Text {
                                    text: "S" + (idx + 1);
                                    font-family: Theme.mono-font;
                                    font-size: 9px;
                                    font-weight: is-active ? 700 : 500;
                                    color: is-active ? Theme.status-online : Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }

                            ta-stage := TouchArea {
                                enabled: idx < root.dpi-count;
                                clicked => { root.dpi-stage-selected(idx); }
                            }
                        }

                        // Barra visual do nível de DPI
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 310px;
                                height: 10px;
                                border-radius: 3px;
                                background: Theme.background;
                                border-color: is-active ? Theme.border-light : Theme.border;
                                border-width: 1px;

                                property <int> cur-dpi: idx < root.dpi-values.length ? root.dpi-values[idx] : 800;

                                Rectangle {
                                    x: 1px;
                                    y: 1px;
                                    height: 8px;
                                    width: 308px * clamp((cur-dpi * 1.0) / 26000.0, 0.02, 1.0);
                                    border-radius: 2px;
                                    background: is-active ? Theme.status-online : Theme.text-secondary;
                                }
                            }
                        }

                        MousePill {
                            text: "-500";
                            pill-width: 40px;
                            pill-height: 22px;
                            enabled: idx < root.dpi-count;
                            clicked => { root.dpi-step(idx, -500); }
                        }
                        MousePill {
                            text: "-50";
                            pill-width: 36px;
                            pill-height: 22px;
                            enabled: idx < root.dpi-count;
                            clicked => { root.dpi-step(idx, -50); }
                        }

                        // Caixa numérica editável
                        Rectangle {
                            width: 64px;
                            height: 22px;
                            border-radius: Theme.radius-sm;
                            background: Theme.background;
                            border-color: is-active ? Theme.border-light : Theme.border;
                            border-width: 1px;

                            TextInput {
                                width: 56px;
                                x: 4px;
                                y: 4px;
                                text: idx < root.dpi-texts.length ? root.dpi-texts[idx] : "800";
                                font-family: Theme.mono-font;
                                font-size: 10px;
                                font-weight: 700;
                                color: Theme.text-primary;
                                horizontal-alignment: center;
                                enabled: idx < root.dpi-count;
                                edited => { root.dpi-text-edited(idx, self.text); }
                                accepted => { root.dpi-text-committed(idx, self.text); }
                            }
                        }

                        MousePill {
                            text: "+50";
                            pill-width: 36px;
                            pill-height: 22px;
                            enabled: idx < root.dpi-count;
                            clicked => { root.dpi-step(idx, 50); }
                        }
                        MousePill {
                            text: "+500";
                            pill-width: 40px;
                            pill-height: 22px;
                            enabled: idx < root.dpi-count;
                            clicked => { root.dpi-step(idx, 500); }
                        }

                        Text {
                            width: 44px;
                            text: is-active ? "ATIVO" : (idx < root.dpi-count ? "" : "INATIVO");
                            font-family: Theme.mono-font;
                            font-size: 8px;
                            font-weight: 700;
                            color: is-active ? Theme.status-online : Theme.text-muted;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Card 2: Polling Rate, LOD, Sensor & Debounce
            Rectangle {
                width: 720px;
                height: 214px;
                background: Theme.surface;
                border-radius: Theme.radius-lg;
                border-color: Theme.border;
                border-width: 1px;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    // Linha 1: Polling Rate + LOD
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "TAXA DE POLLING (HZ)";
                                font-family: Theme.mono-font;
                                font-size: 9px;
                                font-weight: 700;
                                color: Theme.text-muted;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                MousePill { text: "125 Hz"; pill-width: 68px; active: root.polling-idx == 0; clicked => { root.polling-selected(0); } }
                                MousePill { text: "250 Hz"; pill-width: 68px; active: root.polling-idx == 1; clicked => { root.polling-selected(1); } }
                                MousePill { text: "500 Hz"; pill-width: 68px; active: root.polling-idx == 2; clicked => { root.polling-selected(2); } }
                                MousePill { text: "1000 Hz"; pill-width: 72px; active: root.polling-idx == 3; clicked => { root.polling-selected(3); } }
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "LIFT-OFF DISTANCE (LOD)";
                                font-family: Theme.mono-font;
                                font-size: 9px;
                                font-weight: 700;
                                color: Theme.text-muted;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                MousePill { text: "1 mm (Baixo)"; pill-width: 96px; active: root.lod-idx == 0; clicked => { root.lod-selected(0); } }
                                MousePill { text: "2 mm (Alto)"; pill-width: 96px; active: root.lod-idx == 1; clicked => { root.lod-selected(1); } }
                            }
                        }
                    }

                    // Linha 2: Flags do Sensor & Rádio
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "SENSOR & MODO DE RÁDIO";
                            font-family: Theme.mono-font;
                            font-size: 9px;
                            font-weight: 700;
                            color: Theme.text-muted;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            MousePill {
                                text: root.motion-sync ? "Motion Sync: ON" : "Motion Sync: OFF";
                                pill-width: 167px;
                                pill-height: 26px;
                                active: root.motion-sync;
                                highlight: root.motion-sync;
                                clicked => { root.sensor-toggled(0); }
                            }
                            MousePill {
                                text: root.ripple-control ? "Ripple Control: ON" : "Ripple Control: OFF";
                                pill-width: 167px;
                                pill-height: 26px;
                                active: root.ripple-control;
                                highlight: root.ripple-control;
                                clicked => { root.sensor-toggled(1); }
                            }
                            MousePill {
                                text: root.linear-correction ? "Angle Snapping: ON" : "Angle Snapping: OFF";
                                pill-width: 167px;
                                pill-height: 26px;
                                active: root.linear-correction;
                                highlight: root.linear-correction;
                                clicked => { root.sensor-toggled(2); }
                            }
                            MousePill {
                                text: root.highspeed-mode ? "High-Speed: ON" : "High-Speed: OFF";
                                pill-width: 167px;
                                pill-height: 26px;
                                active: root.highspeed-mode;
                                highlight: root.highspeed-mode;
                                clicked => { root.highspeed-toggled(); }
                            }
                        }
                    }

                    // Linha 3: Debounce (Key Response Delay 1..50ms)
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "DEBOUNCE / KEY RESPONSE DELAY (1 - 50 MS)";
                            font-family: Theme.mono-font;
                            font-size: 9px;
                            font-weight: 700;
                            color: Theme.text-muted;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            MousePill { text: "-1 ms"; pill-width: 54px; clicked => { root.debounce-step(-1); } }
                            Rectangle {
                                width: 64px;
                                height: 24px;
                                border-radius: Theme.radius-sm;
                                background: Theme.background;
                                border-color: Theme.border-light;
                                border-width: 1px;
                                Text {
                                    text: root.debounce-ms + " ms";
                                    font-family: Theme.mono-font;
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            MousePill { text: "+1 ms"; pill-width: 54px; clicked => { root.debounce-step(1); } }

                            Rectangle { width: 12px; }

                            MousePill { text: "1 ms"; pill-width: 54px; active: root.debounce-ms == 1; clicked => { root.debounce-set(1); } }
                            MousePill { text: "2 ms"; pill-width: 54px; active: root.debounce-ms == 2; clicked => { root.debounce-set(2); } }
                            MousePill { text: "4 ms"; pill-width: 54px; active: root.debounce-ms == 4; clicked => { root.debounce-set(4); } }
                            MousePill { text: "8 ms"; pill-width: 54px; active: root.debounce-ms == 8; clicked => { root.debounce-set(8); } }
                            MousePill { text: "12 ms"; pill-width: 54px; active: root.debounce-ms == 12; clicked => { root.debounce-set(12); } }
                            MousePill { text: "20 ms"; pill-width: 54px; active: root.debounce-ms == 20; clicked => { root.debounce-set(20); } }
                        }
                    }
                }
            }
        }

        // ============================================================
        // SUB-ABA 1: BOTÕES (ESQUEMA 5 BOTÕES + EDITOR)
