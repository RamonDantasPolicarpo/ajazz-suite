                                text: root.slot-title;
                                font-family: Theme.mono-font;
                                font-size: 9px;
                                font-weight: 700;
                                color: Theme.text-primary;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        Text {
                            max-width: 240px;
                            text: "Atual: " + root.slot-current-binding;
                            font-family: Theme.mono-font;
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    // Aviso de segurança de Clique Esquerdo
                    if (root.btn-left-warning) : Rectangle {
                        height: 28px;
                        border-radius: Theme.radius-sm;
                        background: #3A2F12;
                        border-color: Theme.status-warning;
                        border-width: 1px;

                        Text {
                            width: parent.width - 20px;
                            text: "Trava ativa: mantenha pelo menos um botão com Clique Esquerdo.";
                            font-family: Theme.mono-font;
                            font-size: 9px;
                            font-weight: 700;
                            color: Theme.status-warning;
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                            overflow: elide;
                        }
                    }

                    // Categorias de Ação (soma exata = 432px)
                    HorizontalLayout {
                        spacing: 4px;
                        MousePill { text: "Mouse"; pill-width: 70px; active: root.btn-category == 0; clicked => { root.btn-category-selected(0); } }
                        MousePill { text: "Teclado"; pill-width: 72px; active: root.btn-category == 1; clicked => { root.btn-category-selected(1); } }
                        MousePill { text: "Mídia"; pill-width: 66px; active: root.btn-category == 2; clicked => { root.btn-category-selected(2); } }
                        MousePill { text: "Sistema"; pill-width: 70px; active: root.btn-category == 3; clicked => { root.btn-category-selected(3); } }
                        MousePill { text: "Macro"; pill-width: 66px; active: root.btn-category == 4; clicked => { root.btn-category-selected(4); } }
                        MousePill { text: "Desab."; pill-width: 68px; active: root.btn-category == 5; clicked => { root.btn-category-selected(5); } }
                    }

                    // Conteúdo da Categoria
                    Rectangle {
                        height: root.btn-left-warning ? 318px : 356px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-color: Theme.border;
                        border-width: 1px;

                        // Cat 0: Funções de Mouse
                        if (root.btn-category == 0) : VerticalLayout {
                            padding: 14px;
                            spacing: 10px;
                            alignment: start;

                            Text {
                                text: "ESCOLHA A FUNÇÃO DE MOUSE";
                                font-family: Theme.mono-font;
                                font-size: 9px;
                                font-weight: 700;
                                color: Theme.text-muted;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                MousePill { text: "Clique Esq."; pill-width: 196px; pill-height: 34px; active: root.btn-mouse-idx == 0; clicked => { root.btn-mouse-selected(0); } }
                                MousePill { text: "Clique Dir."; pill-width: 196px; pill-height: 34px; active: root.btn-mouse-idx == 1; clicked => { root.btn-mouse-selected(1); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                MousePill { text: "Botão do Meio"; pill-width: 196px; pill-height: 34px; active: root.btn-mouse-idx == 2; clicked => { root.btn-mouse-selected(2); } }
                                MousePill { text: "Duplo Clique (Esq.)"; pill-width: 196px; pill-height: 34px; active: root.btn-mouse-idx == 3; clicked => { root.btn-mouse-selected(3); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                MousePill { text: "Avançar (Forward)"; pill-width: 196px; pill-height: 34px; active: root.btn-mouse-idx == 4; clicked => { root.btn-mouse-selected(4); } }
                                MousePill { text: "Voltar (Back)"; pill-width: 196px; pill-height: 34px; active: root.btn-mouse-idx == 5; clicked => { root.btn-mouse-selected(5); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                MousePill { text: "Scroll Cima"; pill-width: 196px; pill-height: 34px; active: root.btn-mouse-idx == 6; clicked => { root.btn-mouse-selected(6); } }
                                MousePill { text: "Scroll Baixo"; pill-width: 196px; pill-height: 34px; active: root.btn-mouse-idx == 7; clicked => { root.btn-mouse-selected(7); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                MousePill { text: "DPI + (Próximo)"; pill-width: 196px; pill-height: 34px; active: root.btn-mouse-idx == 8; clicked => { root.btn-mouse-selected(8); } }
                                MousePill { text: "DPI - (Anterior)"; pill-width: 196px; pill-height: 34px; active: root.btn-mouse-idx == 9; clicked => { root.btn-mouse-selected(9); } }
                            }
                        }

                        // Cat 1: Teclado / Atalhos
                        if (root.btn-category == 1) : VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 4px;
                                    MousePill { text: "Ctrl"; pill-width: 48px; active: (Math.mod(root.btn-mod-mask, 2) == 1); clicked => { root.btn-toggle-modifier(1); } }
                                    MousePill { text: "Shift"; pill-width: 48px; active: (Math.mod(Math.floor(root.btn-mod-mask / 2), 2) == 1); clicked => { root.btn-toggle-modifier(2); } }
                                    MousePill { text: "Alt"; pill-width: 48px; active: (Math.mod(Math.floor(root.btn-mod-mask / 4), 2) == 1); clicked => { root.btn-toggle-modifier(4); } }
                                    MousePill { text: "Win"; pill-width: 48px; active: (Math.mod(Math.floor(root.btn-mod-mask / 8), 2) == 1); clicked => { root.btn-toggle-modifier(8); } }
                                }

                                Rectangle {
                                    width: 152px;
                                    height: 24px;
                                    border-radius: Theme.radius-sm;
                                    background: root.btn-capturing-key ? Theme.status-warning : (cap-ta.has-hover ? Theme.surface-hover : Theme.surface);
                                    border-color: root.btn-capturing-key ? Theme.status-warning : Theme.border-light;
                                    border-width: 1px;

                                    Text {
                                        text: root.btn-capturing-key ? "APERTE A TECLA..." : "CAPTURAR TECLA";
                                        font-family: Theme.mono-font;
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: root.btn-capturing-key ? #18181B : Theme.text-primary;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    cap-fs := FocusScope {
                                        key-pressed(ev) => {
                                            if (root.btn-capturing-key) {
                                                root.btn-capture-key(
                                                    ev.text,
                                                    ev.modifiers.control,
                                                    ev.modifiers.shift,
                                                    ev.modifiers.alt,
                                                    ev.modifiers.meta
                                                );
                                                root.btn-capturing-key = false;
                                                return accept;
                                            }
                                            reject
                                        }
                                    }

                                    cap-ta := TouchArea {
                                        clicked => {
                                            root.btn-capturing-key = !root.btn-capturing-key;
                                            if (root.btn-capturing-key) {
                                                cap-fs.focus();
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: root.btn-key-idx < root.key-catalog-labels.length
                                    ? "Tecla selecionada: " + root.key-catalog-labels[root.btn-key-idx]
                                    : "Selecione uma tecla:";
                                font-family: Theme.mono-font;
                                font-size: 9px;
                                font-weight: 700;
                                color: Theme.text-primary;
                            }

                            Flickable {
                                height: root.btn-left-warning ? 228px : 266px;
                                content-height: mcat-col.preferred-height;

                                mcat-col := VerticalLayout {
                                    spacing: 4px;
                                    for r_idx in 22 : HorizontalLayout {
                                        spacing: 4px;
                                        for c_idx in 5 : Rectangle {
                                            width: 78px;
                                            height: 22px;
                                            property <int> flat-idx: r_idx * 5 + c_idx;
                                            visible: flat-idx < root.key-catalog-labels.length;
                                            border-radius: Theme.radius-sm;
                                            background: root.btn-key-idx == flat-idx ? Theme.surface-active : (mk-ta.has-hover ? Theme.surface-hover : Theme.surface);
                                            border-color: root.btn-key-idx == flat-idx ? Theme.text-primary : Theme.border;
                                            border-width: 1px;

                                            Text {
                                                text: flat-idx < root.key-catalog-labels.length ? root.key-catalog-labels[flat-idx] : "";
                                                font-family: Theme.mono-font;
                                                font-size: 9px;
                                                font-weight: root.btn-key-idx == flat-idx ? 700 : 500;
                                                color: root.btn-key-idx == flat-idx ? Theme.text-primary : Theme.text-secondary;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            mk-ta := TouchArea {
                                                enabled: flat-idx < root.key-catalog-labels.length;
                                                clicked => {
                                                    root.btn-capturing-key = false;
                                                    root.btn-catalog-key-selected(flat-idx);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Cat 2: Mídia / Consumer
                        if (root.btn-category == 2) : VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: "CONTROLES MULTIMÍDIA & ATALHOS DO WINDOWS";
                                font-family: Theme.mono-font;
                                font-size: 9px;
                                font-weight: 700;
                                color: Theme.text-muted;
                            }

                            Flickable {
                                height: root.btn-left-warning ? 262px : 300px;
                                content-height: med-col.preferred-height;

                                med-col := VerticalLayout {
                                    spacing: 6px;
                                    for r_idx in 7 : HorizontalLayout {
                                        spacing: 6px;
                                        for c_idx in 3 : Rectangle {
                                            width: 132px;
                                            height: 28px;
                                            property <int> m-idx: r_idx * 3 + c_idx;
                                            visible: m-idx < root.media-labels.length;
                                            border-radius: Theme.radius-sm;
                                            background: root.btn-media-idx == m-idx ? Theme.surface-active : (md-ta.has-hover ? Theme.surface-hover : Theme.surface);
                                            border-color: root.btn-media-idx == m-idx ? Theme.text-primary : Theme.border;
                                            border-width: 1px;

                                            Text {
                                                width: parent.width - 10px;
                                                text: m-idx < root.media-labels.length ? root.media-labels[m-idx] : "";
                                                font-family: Theme.mono-font;
                                                font-size: 9px;
                                                font-weight: root.btn-media-idx == m-idx ? 700 : 500;
                                                color: root.btn-media-idx == m-idx ? Theme.text-primary : Theme.text-secondary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                x: 5px;
                                                y: (parent.height - self.height) / 2;
                                                overflow: elide;
                                            }

                                            md-ta := TouchArea {
                                                enabled: m-idx < root.media-labels.length;
                                                clicked => { root.btn-media-selected(m-idx); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Cat 3: Sistema ACPI (40 01|02|04 00 00)
                        if (root.btn-category == 3) : VerticalLayout {
                            padding: 14px;
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "ATALHOS ACPI DE SISTEMA (CONTROLAM ENERGIA DO PC)";
                                font-family: Theme.mono-font;
                                font-size: 9px;
                                font-weight: 700;
                                color: Theme.status-warning;
                            }

                            MousePill {
                                text: "Power (0x40 01) — Desliga / Suspende o PC";
                                pill-width: 404px;
                                pill-height: 36px;
                                active: root.btn-system-idx == 0;
                                clicked => { root.btn-system-selected(0); }
                            }
                            MousePill {
                                text: "Sleep (0x40 02) — Entra em Suspensão";
                                pill-width: 404px;
                                pill-height: 36px;
                                active: root.btn-system-idx == 1;
                                clicked => { root.btn-system-selected(1); }
                            }
                            MousePill {
                                text: "Wake Up (0x40 04) — Acorda o PC";
                                pill-width: 404px;
                                pill-height: 36px;
                                active: root.btn-system-idx == 2;
                                clicked => { root.btn-system-selected(2); }
                            }

                            Text {
                                text: "Para trocar DPI no botão sem suspender o PC, use DPI + ou DPI - na aba Mouse.";
                                font-size: 11px;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                        }

                        // Cat 4: Macro Compartilhada (06 31 + 60 <idx> <modo> <qtd>)
                        if (root.btn-category == 4) : VerticalLayout {
                            padding: 14px;
                            spacing: 10px;
                            alignment: start;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "ESCOLHER MACRO DA BIBLIOTECA (06 31)";
                                    font-family: Theme.mono-font;
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                                MousePill {
                                    text: "Gerenciar Macros ->";
                                    pill-width: 132px;
                                    pill-height: 22px;
                                    clicked => { root.open-macro-editor-clicked(); }
                                }
                            }

                            if (root.macro-names.length == 0) : Rectangle {
                                height: 150px;
                                background: Theme.background;
                                border-radius: Theme.radius-sm;
                                border-color: Theme.border;
                                border-width: 1px;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    padding: 12px;
                                    Text {
                                        text: "Nenhuma macro cadastrada na biblioteca ainda.";
                                        font-family: Theme.mono-font;
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Clique em 'Gerenciar Macros ->' acima para gravar ou editar uma macro.";
                                        font-family: Theme.mono-font;
                                        font-size: 9px;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if (root.macro-names.length > 0) : Flickable {
                                height: root.btn-left-warning ? 118px : 156px;
                                content-height: ceil(root.macro-names.length / 2.0) * 34px;

                                for mname[midx] in root.macro-names : MousePill {
                                    x: mod(midx, 2) * 204px;
                                    y: floor(midx / 2) * 34px;
                                    text: "#" + (midx + 1) + " " + mname;
                                    pill-width: 196px;
                                    pill-height: 28px;
                                    active: root.btn-macro-idx == midx;
                                    enabled: midx < 32;
                                    clicked => { root.btn-macro-selected(midx); }
                                }
                            }

                            Text {
                                text: "MODO DE DISPARO NO MOUSE";
                                font-family: Theme.mono-font;
                                font-size: 9px;
                                font-weight: 700;
                                color: Theme.text-muted;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                MousePill {
                                    text: "N vezes";
                                    pill-width: 120px;
                                    pill-height: 28px;
                                    active: root.btn-macro-mode == 0;
                                    clicked => { root.btn-macro-mode-selected(0); }
                                }
                                MousePill {
                                    text: "Até soltar";
                                    pill-width: 120px;
                                    pill-height: 28px;
                                    active: root.btn-macro-mode == 1;
                                    clicked => { root.btn-macro-mode-selected(1); }
                                }
                                MousePill {
                                    text: "Alternar (ON/OFF)";
                                    pill-width: 152px;
                                    pill-height: 28px;
                                    active: root.btn-macro-mode == 2;
                                    clicked => { root.btn-macro-mode-selected(2); }
                                }
                            }

                            if (root.btn-macro-mode == 0) : HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: "Repetições:";
                                    font-family: Theme.mono-font;
                                    font-size: 9px;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                                MousePill { text: "-1"; pill-width: 34px; pill-height: 24px; clicked => { root.btn-macro-repeat-step(-1); } }
                                Rectangle {
                                    width: 48px;
                                    height: 24px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.background;
                                    border-color: Theme.border;
                                    border-width: 1px;
                                    Text {
                                        text: root.btn-macro-repeat + "x";
                                        font-family: Theme.mono-font;
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                                MousePill { text: "+1"; pill-width: 34px; pill-height: 24px; clicked => { root.btn-macro-repeat-step(1); } }
                            }
                        }

                        // Cat 5: Desabilitar
                        if (root.btn-category == 5) : VerticalLayout {
                            padding: 20px;
                            spacing: 8px;
                            alignment: center;

                            Text {
                                text: "BOTÃO DESABILITADO (00 00 00 00)";
                                font-family: Theme.mono-font;
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.text-primary;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Nenhuma ação será disparada ao pressionar este botão.";
                                font-family: Theme.mono-font;
                                font-size: 9px;
                                color: Theme.text-secondary;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Rodapé Aplicar Botão
                    HorizontalLayout {
                        alignment: end;
                        MousePill {
                            text: "APLICAR BOTÃO NO MOUSE";
                            pill-width: 196px;
                            pill-height: 28px;
                            enabled: root.ms-connected && !root.btn-left-warning && !(root.btn-category == 4 && root.macro-names.length == 0);
                            highlight: root.ms-connected && !root.btn-left-warning && !(root.btn-category == 4 && root.macro-names.length == 0);
                            clicked => { root.apply-button-clicked(); }
                        }
                    }
                }
            }
        }

        // ============================================================
        // SUB-ABA 2: ENERGIA & CONEXÃO
        // ============================================================
        if (root.subtab == 2) : VerticalLayout {
            width: 720px;
            spacing: 12px;

            // Card 1: Temporizadores de Sleep
            Rectangle {
                width: 720px;
                height: 186px;
                background: Theme.surface;
                border-radius: Theme.radius-lg;
                border-color: Theme.border;
                border-width: 1px;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    Text {
                        text: "ECONOMIA DE ENERGIA SEM FIO (NEARLINK 2.4G)";
                        font-family: Theme.mono-font;
                        font-size: 9px;
                        font-weight: 700;
                        color: Theme.text-muted;
                    }

                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "LIGHT SLEEP (ESPERA LEVE) — Atual: " + root.light-sleep-label;
                            font-family: Theme.mono-font;
                            font-size: 10px;
                            font-weight: 600;
                            color: Theme.text-primary;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            MousePill { text: "10s"; pill-width: 78px; active: root.light-sleep == 10; clicked => { root.light-sleep-selected(10); } }
                            MousePill { text: "30s"; pill-width: 78px; active: root.light-sleep == 30; clicked => { root.light-sleep-selected(30); } }
                            MousePill { text: "1 min"; pill-width: 78px; active: root.light-sleep == 60; clicked => { root.light-sleep-selected(60); } }
                            MousePill { text: "3 min"; pill-width: 78px; active: root.light-sleep == 180; clicked => { root.light-sleep-selected(180); } }
                            MousePill { text: "Desligado"; pill-width: 90px; active: root.light-sleep == 0; clicked => { root.light-sleep-selected(0); } }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "DEEP SLEEP (SUSPENSÃO PROFUNDA) — Atual: " + root.deep-sleep-label;
                            font-family: Theme.mono-font;
                            font-size: 10px;
                            font-weight: 600;
                            color: Theme.text-primary;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            MousePill { text: "3 min"; pill-width: 78px; active: root.deep-sleep == 180; clicked => { root.deep-sleep-selected(180); } }
                            MousePill { text: "5 min"; pill-width: 78px; active: root.deep-sleep == 300; clicked => { root.deep-sleep-selected(300); } }
                            MousePill { text: "10 min"; pill-width: 78px; active: root.deep-sleep == 600; clicked => { root.deep-sleep-selected(600); } }
                            MousePill { text: "30 min"; pill-width: 78px; active: root.deep-sleep == 1800; clicked => { root.deep-sleep-selected(1800); } }
                            MousePill { text: "Desligado"; pill-width: 90px; active: root.deep-sleep == 0; clicked => { root.deep-sleep-selected(0); } }
                        }
                    }
                }
            }

            // Card 2: Direção do Scroll
            Rectangle {
                width: 720px;
                height: 82px;
                background: Theme.surface;
                border-radius: Theme.radius-lg;
                border-color: Theme.border;
                border-width: 1px;

                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;

                    Text {
                        text: "SENTIDO DA RODA DE SCROLL";
                        font-family: Theme.mono-font;
                        font-size: 9px;
                        font-weight: 700;
                        color: Theme.text-muted;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        MousePill { text: "Normal (Forward)"; pill-width: 160px; pill-height: 26px; active: root.scroll-idx == 0; clicked => { root.scroll-selected(0); } }
                        MousePill { text: "Invertido (Reverse)"; pill-width: 160px; pill-height: 26px; active: root.scroll-idx == 1; clicked => { root.scroll-selected(1); } }
                    }
                }
            }

            // Card 3: Pareamento NearLink 2.4G (06 13 09) com confirmação
            Rectangle {
                width: 720px;
                height: 112px;
                background: Theme.surface;
                border-radius: Theme.radius-lg;
                border-color: root.confirm-pairing ? Theme.status-warning : Theme.border;
                border-width: 1px;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    Text {
                        text: "PAREAMENTO DO RECEPTOR NEARLINK 2.4G (OPCODE 06 13 09)";
                        font-family: Theme.mono-font;
                        font-size: 9px;
                        font-weight: 700;
                        color: Theme.text-muted;
                    }

                    Text {
                        width: parent.width - 28px;
                        text: "Coloca o dongle USB em modo de pareamento (~30s). Aproxime o mouse ligado em 2.4G para reemparelhar.";
                        font-family: Theme.mono-font;
                        font-size: 9px;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        if (!root.confirm-pairing) : MousePill {
                            text: "INICIAR PAREAMENTO 2.4G";
                            pill-width: 190px;
                            pill-height: 26px;
                            enabled: root.ms-connected;
                            clicked => { root.confirm-pairing = true; }
                        }

                        if (root.confirm-pairing) : HorizontalLayout {
                            spacing: 8px;
                            MousePill {
                                text: "CONFIRMAR PAREAMENTO AGORA";
                                pill-width: 210px;
                                pill-height: 26px;
                                highlight: true;
                                clicked => {
                                    root.confirm-pairing = false;
                                    root.start-pairing-clicked();
                                }
                            }
                            MousePill {
                                text: "CANCELAR";
                                pill-width: 96px;
                                pill-height: 26px;
                                clicked => { root.confirm-pairing = false; }
                            }
                        }
                    }
                }
            }
        }

        // ============================================================
        // SUB-ABA 3: DIAGNÓSTICO DE SWITCH CHATTERING
        // ============================================================
        if (root.subtab == 3) : VerticalLayout {
            spacing: 10px;
            width: 720px;

            Rectangle {
                width: 720px;
                height: 120px;
                background: Theme.surface;
                border-radius: Theme.radius-lg;
                border-color: root.chatter-total > 0 ? Theme.status-error : Theme.border;
                border-width: 1px;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "MONITOR PASSIVO DE SWITCH CHATTERING (RAW INPUT)";
                            font-family: Theme.mono-font;
                            font-size: 9px;
                            font-weight: 700;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.chatter-enabled ? "0% CPU EM IDLE" : "PAUSADO";
                            font-family: Theme.mono-font;
                            font-size: 9px;
                            font-weight: 700;
                            color: root.chatter-enabled ? Theme.status-online : Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        width: parent.width - 28px;
                        text: root.chatter-alert-text;
                        font-family: Theme.mono-font;
                        font-size: 10px;
                        font-weight: 700;
                        color: root.chatter-total > 0 ? Theme.status-error : Theme.status-online;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px;
                            MousePill {
                                text: root.chatter-enabled ? "MONITOR: ATIVO" : "MONITOR: PAUSADO";
                                pill-width: 138px;
                                pill-height: 26px;
                                active: root.chatter-enabled;
                                highlight: root.chatter-enabled;
                                clicked => { root.chatter-toggle-clicked(); }
                            }
                            MousePill {
                                text: "-5 ms";
                                pill-width: 54px;
                                pill-height: 26px;
                                clicked => { root.chatter-threshold-step(-5); }
                            }
                            Rectangle {
                                width: 108px;
                                height: 26px;
                                border-radius: Theme.radius-sm;
                                background: Theme.background;
                                border-color: Theme.border;
                                border-width: 1px;
                                Text {
                                    text: "Limite: " + root.chatter-threshold-ms + " ms";
                                    font-family: Theme.mono-font;
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            MousePill {
                                text: "+5 ms";
                                pill-width: 54px;
                                pill-height: 26px;
                                clicked => { root.chatter-threshold-step(5); }
                            }
                        }

                        MousePill {
                            text: "ZERAR CONTADORES";
                            pill-width: 146px;
                            pill-height: 26px;
                            clicked => { root.chatter-reset-clicked(); }
                        }
                    }
                }
            }

            Rectangle {
                width: 720px;
                height: 316px;
                background: Theme.surface;
                border-radius: Theme.radius-lg;
                border-color: Theme.border;
                border-width: 1px;

                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;

                    Text {
                        text: "TELEMETRIA POR SWITCH FÍSICO";
                        font-family: Theme.mono-font;
                        font-size: 9px;
                        font-weight: 700;
                        color: Theme.text-muted;
                    }

                    // Cabeçalho da tabela
                    HorizontalLayout {
                        height: 24px;
                        padding-left: 10px;
                        padding-right: 10px;
                        Text { text: "BOTÃO"; width: 200px; font-family: Theme.mono-font; font-size: 8px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { text: "CLIQUES"; width: 100px; font-family: Theme.mono-font; font-size: 8px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { text: "CHATTER"; width: 100px; font-family: Theme.mono-font; font-size: 8px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { text: "ÚLTIMO HIATO"; width: 130px; font-family: Theme.mono-font; font-size: 8px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { text: "MENOR HIATO"; width: 130px; font-family: Theme.mono-font; font-size: 8px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                    }

                    for row in root.chatter-rows : Rectangle {
                        height: 34px;
                        border-radius: Theme.radius-sm;
                        background: row.has-chatter ? #3A1C1C : Theme.surface-raised;
                        border-color: row.has-chatter ? Theme.status-error : Theme.border;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: row.button-name;
                                width: 200px;
                                font-family: Theme.mono-font;
                                font-size: 10px;
                                font-weight: 700;
                                color: row.has-chatter ? Theme.status-error : Theme.text-primary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "" + row.total-clicks;
                                width: 100px;
                                font-family: Theme.mono-font;
                                font-size: 10px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "" + row.chatter-count;
                                width: 100px;
                                font-family: Theme.mono-font;
                                font-size: 10px;
                                font-weight: 700;
                                color: row.has-chatter ? Theme.status-error : Theme.status-online;
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.last-ms;
                                width: 130px;
                                font-family: Theme.mono-font;
                                font-size: 10px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.min-ms;
                                width: 130px;
                                font-family: Theme.mono-font;
                                font-size: 10px;
                                font-weight: 700;
                                color: row.has-chatter ? Theme.status-error : Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        width: parent.width - 28px;
                        text: "Dica: eventos Stuck Input (UP perdido ou retenção >=10s) exibem a bateria (%) no momento; rebotes <= limite ms indicam Switch Chattering.";
                        font-size: 10px;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
