                Rectangle { width: 4px; }
                Keycap { label: "ENTER"; key-width: 78px; led-color: root.resolved-color(56); has-led: root.key-active(56); is-selected: root.selected-key-idx == 56; is-remapped: root.key-remapped(56); clicked => { root.key-clicked(56); } }
                Rectangle { width: 4px; }
                Keycap { label: "PGDN"; key-width: 32px; led-color: root.resolved-color(57); has-led: root.key-active(57); is-selected: root.selected-key-idx == 57; is-remapped: root.key-remapped(57); clicked => { root.key-clicked(57); } }
            }

            // Row 4: LSHIFT(58) + Z../(68) + RSHIFT(69) + UP(71) + END(70)
            HorizontalLayout {
                spacing: 0px;
                alignment: start;

                Keycap { label: "SHIFT"; key-width: 76px; led-color: root.resolved-color(58); has-led: root.key-active(58); is-selected: root.selected-key-idx == 58; is-remapped: root.key-remapped(58); clicked => { root.key-clicked(58); } }
                Rectangle { width: 4px; }
