            // Row 5: LCTRL(72)..RIGHT(81)
            HorizontalLayout {
                spacing: 0px;
                alignment: start;

                Keycap { label: "CTRL"; key-width: 41px; led-color: root.resolved-color(72); has-led: root.key-active(72); is-selected: root.selected-key-idx == 72; is-remapped: root.key-remapped(72); clicked => { root.key-clicked(72); } }
