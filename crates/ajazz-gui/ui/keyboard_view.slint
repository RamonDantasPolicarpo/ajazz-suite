import { Theme } from "theme.slint";
import { Keycap } from "keycap.slint";

export component KeyboardView inherits Rectangle {
    in property <color> global-led-color: #000000;
    in property <bool> has-led: false;
    in property <[color]> key-colors: [];
    in property <string> chattering-key: "";

    callback key-clicked(int);

    pure function resolved-color(idx: int) -> color {
        idx < root.key-colors.length ? root.key-colors[idx] : root.global-led-color
    }

    pure function key-active(idx: int) -> bool {
        idx < root.key-colors.length ? root.key-colors[idx] != #000000 : root.has-led
    }

    width: 720px;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-color: Theme.border;
    border-width: 1px;

    HorizontalLayout {
        alignment: center;
        padding-top: 14px;
        padding-bottom: 14px;

        VerticalLayout {
            width: 572px;
            spacing: 5px;
            alignment: start;

            // Row 0: Esc(0) + F1-F12(1..12) + Del(13) + Knob
            HorizontalLayout {
                spacing: 0px;
                alignment: start;

                Keycap { label: "ESC"; key-width: 32px; led-color: root.resolved-color(0); has-led: root.key-active(0); has-chattering: root.chattering-key == "ESC"; clicked => { root.key-clicked(0); } }
                Rectangle { width: 10px; }

                Keycap { label: "F1"; key-width: 32px; led-color: root.resolved-color(1); has-led: root.key-active(1); clicked => { root.key-clicked(1); } }
                Rectangle { width: 4px; }
                Keycap { label: "F2"; key-width: 32px; led-color: root.resolved-color(2); has-led: root.key-active(2); clicked => { root.key-clicked(2); } }
                Rectangle { width: 4px; }
                Keycap { label: "F3"; key-width: 32px; led-color: root.resolved-color(3); has-led: root.key-active(3); clicked => { root.key-clicked(3); } }
                Rectangle { width: 4px; }
                Keycap { label: "F4"; key-width: 32px; led-color: root.resolved-color(4); has-led: root.key-active(4); clicked => { root.key-clicked(4); } }
                Rectangle { width: 10px; }

                Keycap { label: "F5"; key-width: 32px; led-color: root.resolved-color(5); has-led: root.key-active(5); clicked => { root.key-clicked(5); } }
                Rectangle { width: 4px; }
                Keycap { label: "F6"; key-width: 32px; led-color: root.resolved-color(6); has-led: root.key-active(6); clicked => { root.key-clicked(6); } }
                Rectangle { width: 4px; }
                Keycap { label: "F7"; key-width: 32px; led-color: root.resolved-color(7); has-led: root.key-active(7); clicked => { root.key-clicked(7); } }
                Rectangle { width: 4px; }
                Keycap { label: "F8"; key-width: 32px; led-color: root.resolved-color(8); has-led: root.key-active(8); clicked => { root.key-clicked(8); } }
                Rectangle { width: 10px; }

                Keycap { label: "F9"; key-width: 32px; led-color: root.resolved-color(9); has-led: root.key-active(9); clicked => { root.key-clicked(9); } }
                Rectangle { width: 4px; }
                Keycap { label: "F10"; key-width: 32px; led-color: root.resolved-color(10); has-led: root.key-active(10); clicked => { root.key-clicked(10); } }
                Rectangle { width: 4px; }
                Keycap { label: "F11"; key-width: 32px; led-color: root.resolved-color(11); has-led: root.key-active(11); clicked => { root.key-clicked(11); } }
                Rectangle { width: 4px; }
                Keycap { label: "F12"; key-width: 32px; led-color: root.resolved-color(12); has-led: root.key-active(12); clicked => { root.key-clicked(12); } }
                Rectangle { width: 10px; }

                Keycap { label: "DEL"; key-width: 32px; led-color: root.resolved-color(13); has-led: root.key-active(13); clicked => { root.key-clicked(13); } }
                Rectangle { width: 14px; }
                Keycap { label: ""; key-width: 34px; is-knob: true; led-color: root.global-led-color; has-led: false; }
            }

            // Row 1: `(14) + 1..=(26) + BKSP(27) + HOME(28)
            HorizontalLayout {
                spacing: 0px;
                alignment: start;

                Keycap { label: "`"; key-width: 32px; led-color: root.resolved-color(14); has-led: root.key-active(14); clicked => { root.key-clicked(14); } }
                Rectangle { width: 4px; }
                Keycap { label: "1"; key-width: 32px; led-color: root.resolved-color(15); has-led: root.key-active(15); clicked => { root.key-clicked(15); } }
                Rectangle { width: 4px; }
                Keycap { label: "2"; key-width: 32px; led-color: root.resolved-color(16); has-led: root.key-active(16); clicked => { root.key-clicked(16); } }
                Rectangle { width: 4px; }
                Keycap { label: "3"; key-width: 32px; led-color: root.resolved-color(17); has-led: root.key-active(17); clicked => { root.key-clicked(17); } }
                Rectangle { width: 4px; }
                Keycap { label: "4"; key-width: 32px; led-color: root.resolved-color(18); has-led: root.key-active(18); clicked => { root.key-clicked(18); } }
                Rectangle { width: 4px; }
                Keycap { label: "5"; key-width: 32px; led-color: root.resolved-color(19); has-led: root.key-active(19); clicked => { root.key-clicked(19); } }
                Rectangle { width: 4px; }
                Keycap { label: "6"; key-width: 32px; led-color: root.resolved-color(20); has-led: root.key-active(20); clicked => { root.key-clicked(20); } }
                Rectangle { width: 4px; }
                Keycap { label: "7"; key-width: 32px; led-color: root.resolved-color(21); has-led: root.key-active(21); clicked => { root.key-clicked(21); } }
                Rectangle { width: 4px; }
                Keycap { label: "8"; key-width: 32px; led-color: root.resolved-color(22); has-led: root.key-active(22); clicked => { root.key-clicked(22); } }
                Rectangle { width: 4px; }
                Keycap { label: "9"; key-width: 32px; led-color: root.resolved-color(23); has-led: root.key-active(23); clicked => { root.key-clicked(23); } }
                Rectangle { width: 4px; }
                Keycap { label: "0"; key-width: 32px; led-color: root.resolved-color(24); has-led: root.key-active(24); clicked => { root.key-clicked(24); } }
                Rectangle { width: 4px; }
                Keycap { label: "-"; key-width: 32px; led-color: root.resolved-color(25); has-led: root.key-active(25); clicked => { root.key-clicked(25); } }
                Rectangle { width: 4px; }
                Keycap { label: "="; key-width: 32px; led-color: root.resolved-color(26); has-led: root.key-active(26); clicked => { root.key-clicked(26); } }
                Rectangle { width: 4px; }
                Keycap { label: "BKSP"; key-width: 68px; led-color: root.resolved-color(27); has-led: root.key-active(27); clicked => { root.key-clicked(27); } }
                Rectangle { width: 4px; }
                Keycap { label: "HOME"; key-width: 32px; led-color: root.resolved-color(28); has-led: root.key-active(28); clicked => { root.key-clicked(28); } }
            }

            // Row 2: TAB(29) + Q..\(42) + PGUP(43)
            HorizontalLayout {
                spacing: 0px;
                alignment: start;

                Keycap { label: "TAB"; key-width: 50px; led-color: root.resolved-color(29); has-led: root.key-active(29); clicked => { root.key-clicked(29); } }
                Rectangle { width: 4px; }
                Keycap { label: "Q"; key-width: 32px; led-color: root.resolved-color(30); has-led: root.key-active(30); clicked => { root.key-clicked(30); } }
                Rectangle { width: 4px; }
                Keycap { label: "W"; key-width: 32px; led-color: root.resolved-color(31); has-led: root.key-active(31); clicked => { root.key-clicked(31); } }
                Rectangle { width: 4px; }
                Keycap { label: "E"; key-width: 32px; led-color: root.resolved-color(32); has-led: root.key-active(32); clicked => { root.key-clicked(32); } }
                Rectangle { width: 4px; }
                Keycap { label: "R"; key-width: 32px; led-color: root.resolved-color(33); has-led: root.key-active(33); clicked => { root.key-clicked(33); } }
                Rectangle { width: 4px; }
                Keycap { label: "T"; key-width: 32px; led-color: root.resolved-color(34); has-led: root.key-active(34); clicked => { root.key-clicked(34); } }
                Rectangle { width: 4px; }
                Keycap { label: "Y"; key-width: 32px; led-color: root.resolved-color(35); has-led: root.key-active(35); clicked => { root.key-clicked(35); } }
                Rectangle { width: 4px; }
                Keycap { label: "U"; key-width: 32px; led-color: root.resolved-color(36); has-led: root.key-active(36); clicked => { root.key-clicked(36); } }
                Rectangle { width: 4px; }
                Keycap { label: "I"; key-width: 32px; led-color: root.resolved-color(37); has-led: root.key-active(37); clicked => { root.key-clicked(37); } }
                Rectangle { width: 4px; }
                Keycap { label: "O"; key-width: 32px; led-color: root.resolved-color(38); has-led: root.key-active(38); clicked => { root.key-clicked(38); } }
                Rectangle { width: 4px; }
                Keycap { label: "P"; key-width: 32px; led-color: root.resolved-color(39); has-led: root.key-active(39); clicked => { root.key-clicked(39); } }
                Rectangle { width: 4px; }
                Keycap { label: "["; key-width: 32px; led-color: root.resolved-color(40); has-led: root.key-active(40); clicked => { root.key-clicked(40); } }
                Rectangle { width: 4px; }
                Keycap { label: "]"; key-width: 32px; led-color: root.resolved-color(41); has-led: root.key-active(41); clicked => { root.key-clicked(41); } }
                Rectangle { width: 4px; }
                Keycap { label: "\\"; key-width: 50px; led-color: root.resolved-color(42); has-led: root.key-active(42); clicked => { root.key-clicked(42); } }
                Rectangle { width: 4px; }
                Keycap { label: "PGUP"; key-width: 32px; led-color: root.resolved-color(43); has-led: root.key-active(43); clicked => { root.key-clicked(43); } }
            }

            // Row 3: CAPS(44) + A..'(55) + ENTER(56) + PGDN(57)
            HorizontalLayout {
                spacing: 0px;
                alignment: start;

                Keycap { label: "CAPS"; key-width: 58px; led-color: root.resolved-color(44); has-led: root.key-active(44); clicked => { root.key-clicked(44); } }
                Rectangle { width: 4px; }
                Keycap { label: "A"; key-width: 32px; led-color: root.resolved-color(45); has-led: root.key-active(45); clicked => { root.key-clicked(45); } }
                Rectangle { width: 4px; }
                Keycap { label: "S"; key-width: 32px; led-color: root.resolved-color(46); has-led: root.key-active(46); clicked => { root.key-clicked(46); } }
                Rectangle { width: 4px; }
                Keycap { label: "D"; key-width: 32px; led-color: root.resolved-color(47); has-led: root.key-active(47); clicked => { root.key-clicked(47); } }
                Rectangle { width: 4px; }
                Keycap { label: "F"; key-width: 32px; led-color: root.resolved-color(48); has-led: root.key-active(48); clicked => { root.key-clicked(48); } }
                Rectangle { width: 4px; }
                Keycap { label: "G"; key-width: 32px; led-color: root.resolved-color(49); has-led: root.key-active(49); clicked => { root.key-clicked(49); } }
                Rectangle { width: 4px; }
                Keycap { label: "H"; key-width: 32px; led-color: root.resolved-color(50); has-led: root.key-active(50); clicked => { root.key-clicked(50); } }
                Rectangle { width: 4px; }
                Keycap { label: "J"; key-width: 32px; led-color: root.resolved-color(51); has-led: root.key-active(51); clicked => { root.key-clicked(51); } }
                Rectangle { width: 4px; }
                Keycap { label: "K"; key-width: 32px; led-color: root.resolved-color(52); has-led: root.key-active(52); clicked => { root.key-clicked(52); } }
                Rectangle { width: 4px; }
                Keycap { label: "L"; key-width: 32px; led-color: root.resolved-color(53); has-led: root.key-active(53); clicked => { root.key-clicked(53); } }
                Rectangle { width: 4px; }
                Keycap { label: ";"; key-width: 32px; led-color: root.resolved-color(54); has-led: root.key-active(54); clicked => { root.key-clicked(54); } }
                Rectangle { width: 4px; }
                Keycap { label: "'"; key-width: 32px; led-color: root.resolved-color(55); has-led: root.key-active(55); clicked => { root.key-clicked(55); } }
                Rectangle { width: 4px; }
                Keycap { label: "ENTER"; key-width: 78px; led-color: root.resolved-color(56); has-led: root.key-active(56); clicked => { root.key-clicked(56); } }
                Rectangle { width: 4px; }
                Keycap { label: "PGDN"; key-width: 32px; led-color: root.resolved-color(57); has-led: root.key-active(57); clicked => { root.key-clicked(57); } }
            }

            // Row 4: LSHIFT(58) + Z../(68) + RSHIFT(69) + UP(71) + END(70)
            HorizontalLayout {
                spacing: 0px;
                alignment: start;

                Keycap { label: "SHIFT"; key-width: 76px; led-color: root.resolved-color(58); has-led: root.key-active(58); clicked => { root.key-clicked(58); } }
                Rectangle { width: 4px; }
                Keycap { label: "Z"; key-width: 32px; led-color: root.resolved-color(59); has-led: root.key-active(59); clicked => { root.key-clicked(59); } }
                Rectangle { width: 4px; }
                Keycap { label: "X"; key-width: 32px; led-color: root.resolved-color(60); has-led: root.key-active(60); clicked => { root.key-clicked(60); } }
                Rectangle { width: 4px; }
                Keycap { label: "C"; key-width: 32px; led-color: root.resolved-color(61); has-led: root.key-active(61); clicked => { root.key-clicked(61); } }
                Rectangle { width: 4px; }
                Keycap { label: "V"; key-width: 32px; led-color: root.resolved-color(62); has-led: root.key-active(62); clicked => { root.key-clicked(62); } }
                Rectangle { width: 4px; }
                Keycap { label: "B"; key-width: 32px; led-color: root.resolved-color(63); has-led: root.key-active(63); clicked => { root.key-clicked(63); } }
                Rectangle { width: 4px; }
                Keycap { label: "N"; key-width: 32px; led-color: root.resolved-color(64); has-led: root.key-active(64); clicked => { root.key-clicked(64); } }
                Rectangle { width: 4px; }
                Keycap { label: "M"; key-width: 32px; led-color: root.resolved-color(65); has-led: root.key-active(65); clicked => { root.key-clicked(65); } }
                Rectangle { width: 4px; }
                Keycap { label: ","; key-width: 32px; led-color: root.resolved-color(66); has-led: root.key-active(66); clicked => { root.key-clicked(66); } }
                Rectangle { width: 4px; }
                Keycap { label: "."; key-width: 32px; led-color: root.resolved-color(67); has-led: root.key-active(67); clicked => { root.key-clicked(67); } }
                Rectangle { width: 4px; }
                Keycap { label: "/"; key-width: 32px; led-color: root.resolved-color(68); has-led: root.key-active(68); clicked => { root.key-clicked(68); } }
                Rectangle { width: 4px; }
                Keycap { label: "SHIFT"; key-width: 60px; led-color: root.resolved-color(69); has-led: root.key-active(69); clicked => { root.key-clicked(69); } }
                Rectangle { width: 4px; }
                Keycap { label: "▲"; key-width: 32px; led-color: root.resolved-color(71); has-led: root.key-active(71); clicked => { root.key-clicked(71); } }
                Rectangle { width: 4px; }
                Keycap { label: "END"; key-width: 32px; led-color: root.resolved-color(70); has-led: root.key-active(70); clicked => { root.key-clicked(70); } }
            }

            // Row 5: LCTRL(72)..RIGHT(81)
            HorizontalLayout {
                spacing: 0px;
                alignment: start;

                Keycap { label: "CTRL"; key-width: 41px; led-color: root.resolved-color(72); has-led: root.key-active(72); clicked => { root.key-clicked(72); } }
                Rectangle { width: 4px; }
                Keycap { label: "WIN"; key-width: 41px; led-color: root.resolved-color(73); has-led: root.key-active(73); clicked => { root.key-clicked(73); } }
                Rectangle { width: 4px; }
                Keycap { label: "ALT"; key-width: 41px; led-color: root.resolved-color(74); has-led: root.key-active(74); clicked => { root.key-clicked(74); } }
                Rectangle { width: 4px; }
                Keycap { label: ""; key-width: 225px; led-color: root.resolved-color(75); has-led: root.key-active(75); clicked => { root.key-clicked(75); } }
                Rectangle { width: 4px; }
                Keycap { label: "ALT"; key-width: 32px; led-color: root.resolved-color(76); has-led: root.key-active(76); clicked => { root.key-clicked(76); } }
                Rectangle { width: 4px; }
                Keycap { label: "FN"; key-width: 32px; led-color: root.resolved-color(77); has-led: root.key-active(77); clicked => { root.key-clicked(77); } }
                Rectangle { width: 4px; }
                Keycap { label: "CTRL"; key-width: 32px; led-color: root.resolved-color(78); has-led: root.key-active(78); clicked => { root.key-clicked(78); } }
                Rectangle { width: 4px; }
                Keycap { label: "◄"; key-width: 32px; led-color: root.resolved-color(79); has-led: root.key-active(79); clicked => { root.key-clicked(79); } }
                Rectangle { width: 4px; }
                Keycap { label: "▼"; key-width: 32px; led-color: root.resolved-color(80); has-led: root.key-active(80); clicked => { root.key-clicked(80); } }
                Rectangle { width: 4px; }
                Keycap { label: "►"; key-width: 32px; led-color: root.resolved-color(81); has-led: root.key-active(81); clicked => { root.key-clicked(81); } }
            }
        }
    }
}
