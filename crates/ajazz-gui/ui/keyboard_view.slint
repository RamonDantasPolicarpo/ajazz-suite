                Keycap { label: "ALT"; key-width: 41px; led-color: root.resolved-color(74); has-led: root.key-active(74); is-selected: root.selected-key-idx == 74; is-remapped: root.key-remapped(74); clicked => { root.key-clicked(74); } }
                Rectangle { width: 4px; }
