import { Theme } from "theme.slint";
import { Keycap } from "keycap.slint";

export component KeyboardView inherits Rectangle {
    in property <color> global-led-color: #000000;
    in property <bool> has-led: false;
    in property <[color]> key-colors: [];
    in property <string> chattering-key: "";
    in property <int> selected-key-idx: -1;
    in property <[bool]> remapped-keys: [];

    callback key-clicked(int);

    pure function resolved-color(idx: int) -> color {
        idx < root.key-colors.length ? root.key-colors[idx] : root.global-led-color
    }

    pure function key-active(idx: int) -> bool {
        idx < root.key-colors.length ? root.key-colors[idx] != #000000 : root.has-led
    }

    pure function key-remapped(idx: int) -> bool {
        idx < root.remapped-keys.length ? root.remapped-keys[idx] : false
    }

    width: 720px;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-color: Theme.border;
    border-width: 1px;

    HorizontalLayout {
        alignment: center;
        padding-top: 10px;
        padding-bottom: 10px;

        VerticalLayout {
            width: 572px;
            spacing: 5px;
            alignment: start;

            // Row 0: Esc(0) + F1-F12(1..12) + Del(13) + Knob
            HorizontalLayout {
                spacing: 0px;
                alignment: start;

                Keycap { label: "ESC"; key-width: 32px; led-color: root.resolved-color(0); has-led: root.key-active(0); has-chattering: root.chattering-key == "ESC"; is-selected: root.selected-key-idx == 0; is-remapped: root.key-remapped(0); clicked => { root.key-clicked(0); } }
                Rectangle { width: 10px; }

                Keycap { label: "F1"; key-width: 32px; led-color: root.resolved-color(1); has-led: root.key-active(1); is-selected: root.selected-key-idx == 1; is-remapped: root.key-remapped(1); clicked => { root.key-clicked(1); } }
                Rectangle { width: 4px; }
                Keycap { label: "F2"; key-width: 32px; led-color: root.resolved-color(2); has-led: root.key-active(2); is-selected: root.selected-key-idx == 2; is-remapped: root.key-remapped(2); clicked => { root.key-clicked(2); } }
                Rectangle { width: 4px; }
                Keycap { label: "F3"; key-width: 32px; led-color: root.resolved-color(3); has-led: root.key-active(3); is-selected: root.selected-key-idx == 3; is-remapped: root.key-remapped(3); clicked => { root.key-clicked(3); } }
                Rectangle { width: 4px; }
                Keycap { label: "F4"; key-width: 32px; led-color: root.resolved-color(4); has-led: root.key-active(4); is-selected: root.selected-key-idx == 4; is-remapped: root.key-remapped(4); clicked => { root.key-clicked(4); } }
                Rectangle { width: 10px; }

                Keycap { label: "F5"; key-width: 32px; led-color: root.resolved-color(5); has-led: root.key-active(5); is-selected: root.selected-key-idx == 5; is-remapped: root.key-remapped(5); clicked => { root.key-clicked(5); } }
                Rectangle { width: 4px; }
                Keycap { label: "F6"; key-width: 32px; led-color: root.resolved-color(6); has-led: root.key-active(6); is-selected: root.selected-key-idx == 6; is-remapped: root.key-remapped(6); clicked => { root.key-clicked(6); } }
                Rectangle { width: 4px; }
                Keycap { label: "F7"; key-width: 32px; led-color: root.resolved-color(7); has-led: root.key-active(7); is-selected: root.selected-key-idx == 7; is-remapped: root.key-remapped(7); clicked => { root.key-clicked(7); } }
                Rectangle { width: 4px; }
                Keycap { label: "F8"; key-width: 32px; led-color: root.resolved-color(8); has-led: root.key-active(8); is-selected: root.selected-key-idx == 8; is-remapped: root.key-remapped(8); clicked => { root.key-clicked(8); } }
                Rectangle { width: 10px; }

                Keycap { label: "F9"; key-width: 32px; led-color: root.resolved-color(9); has-led: root.key-active(9); is-selected: root.selected-key-idx == 9; is-remapped: root.key-remapped(9); clicked => { root.key-clicked(9); } }
                Rectangle { width: 4px; }
                Keycap { label: "F10"; key-width: 32px; led-color: root.resolved-color(10); has-led: root.key-active(10); is-selected: root.selected-key-idx == 10; is-remapped: root.key-remapped(10); clicked => { root.key-clicked(10); } }
                Rectangle { width: 4px; }
                Keycap { label: "F11"; key-width: 32px; led-color: root.resolved-color(11); has-led: root.key-active(11); is-selected: root.selected-key-idx == 11; is-remapped: root.key-remapped(11); clicked => { root.key-clicked(11); } }
                Rectangle { width: 4px; }
                Keycap { label: "F12"; key-width: 32px; led-color: root.resolved-color(12); has-led: root.key-active(12); is-selected: root.selected-key-idx == 12; is-remapped: root.key-remapped(12); clicked => { root.key-clicked(12); } }
                Rectangle { width: 10px; }

                Keycap { label: "DEL"; key-width: 32px; led-color: root.resolved-color(13); has-led: root.key-active(13); is-selected: root.selected-key-idx == 13; is-remapped: root.key-remapped(13); clicked => { root.key-clicked(13); } }
                Rectangle { width: 14px; }
                Keycap { label: ""; key-width: 34px; is-knob: true; led-color: root.global-led-color; has-led: false; }
            }

            // Row 1: `(14) + 1..=(26) + BKSP(27) + HOME(28)
            HorizontalLayout {
                spacing: 0px;
                alignment: start;

                Keycap { label: "`"; key-width: 32px; led-color: root.resolved-color(14); has-led: root.key-active(14); is-selected: root.selected-key-idx == 14; is-remapped: root.key-remapped(14); clicked => { root.key-clicked(14); } }
                Rectangle { width: 4px; }
                Keycap { label: "1"; key-width: 32px; led-color: root.resolved-color(15); has-led: root.key-active(15); is-selected: root.selected-key-idx == 15; is-remapped: root.key-remapped(15); clicked => { root.key-clicked(15); } }
                Rectangle { width: 4px; }
                Keycap { label: "2"; key-width: 32px; led-color: root.resolved-color(16); has-led: root.key-active(16); is-selected: root.selected-key-idx == 16; is-remapped: root.key-remapped(16); clicked => { root.key-clicked(16); } }
                Rectangle { width: 4px; }
                Keycap { label: "3"; key-width: 32px; led-color: root.resolved-color(17); has-led: root.key-active(17); is-selected: root.selected-key-idx == 17; is-remapped: root.key-remapped(17); clicked => { root.key-clicked(17); } }
                Rectangle { width: 4px; }
                Keycap { label: "4"; key-width: 32px; led-color: root.resolved-color(18); has-led: root.key-active(18); is-selected: root.selected-key-idx == 18; is-remapped: root.key-remapped(18); clicked => { root.key-clicked(18); } }
                Rectangle { width: 4px; }
                Keycap { label: "5"; key-width: 32px; led-color: root.resolved-color(19); has-led: root.key-active(19); is-selected: root.selected-key-idx == 19; is-remapped: root.key-remapped(19); clicked => { root.key-clicked(19); } }
                Rectangle { width: 4px; }
                Keycap { label: "6"; key-width: 32px; led-color: root.resolved-color(20); has-led: root.key-active(20); is-selected: root.selected-key-idx == 20; is-remapped: root.key-remapped(20); clicked => { root.key-clicked(20); } }
                Rectangle { width: 4px; }
                Keycap { label: "7"; key-width: 32px; led-color: root.resolved-color(21); has-led: root.key-active(21); is-selected: root.selected-key-idx == 21; is-remapped: root.key-remapped(21); clicked => { root.key-clicked(21); } }
                Rectangle { width: 4px; }
                Keycap { label: "8"; key-width: 32px; led-color: root.resolved-color(22); has-led: root.key-active(22); is-selected: root.selected-key-idx == 22; is-remapped: root.key-remapped(22); clicked => { root.key-clicked(22); } }
                Rectangle { width: 4px; }
                Keycap { label: "9"; key-width: 32px; led-color: root.resolved-color(23); has-led: root.key-active(23); is-selected: root.selected-key-idx == 23; is-remapped: root.key-remapped(23); clicked => { root.key-clicked(23); } }
                Rectangle { width: 4px; }
                Keycap { label: "0"; key-width: 32px; led-color: root.resolved-color(24); has-led: root.key-active(24); is-selected: root.selected-key-idx == 24; is-remapped: root.key-remapped(24); clicked => { root.key-clicked(24); } }
                Rectangle { width: 4px; }
                Keycap { label: "-"; key-width: 32px; led-color: root.resolved-color(25); has-led: root.key-active(25); is-selected: root.selected-key-idx == 25; is-remapped: root.key-remapped(25); clicked => { root.key-clicked(25); } }
                Rectangle { width: 4px; }
                Keycap { label: "="; key-width: 32px; led-color: root.resolved-color(26); has-led: root.key-active(26); is-selected: root.selected-key-idx == 26; is-remapped: root.key-remapped(26); clicked => { root.key-clicked(26); } }
                Rectangle { width: 4px; }
                Keycap { label: "BKSP"; key-width: 68px; led-color: root.resolved-color(27); has-led: root.key-active(27); is-selected: root.selected-key-idx == 27; is-remapped: root.key-remapped(27); clicked => { root.key-clicked(27); } }
                Rectangle { width: 4px; }
                Keycap { label: "HOME"; key-width: 32px; led-color: root.resolved-color(28); has-led: root.key-active(28); is-selected: root.selected-key-idx == 28; is-remapped: root.key-remapped(28); clicked => { root.key-clicked(28); } }
            }

            // Row 2: TAB(29) + Q..\(42) + PGUP(43)
            HorizontalLayout {
                spacing: 0px;
                alignment: start;

                Keycap { label: "TAB"; key-width: 50px; led-color: root.resolved-color(29); has-led: root.key-active(29); is-selected: root.selected-key-idx == 29; is-remapped: root.key-remapped(29); clicked => { root.key-clicked(29); } }
                Rectangle { width: 4px; }
                Keycap { label: "Q"; key-width: 32px; led-color: root.resolved-color(30); has-led: root.key-active(30); is-selected: root.selected-key-idx == 30; is-remapped: root.key-remapped(30); clicked => { root.key-clicked(30); } }
                Rectangle { width: 4px; }
                Keycap { label: "W"; key-width: 32px; led-color: root.resolved-color(31); has-led: root.key-active(31); is-selected: root.selected-key-idx == 31; is-remapped: root.key-remapped(31); clicked => { root.key-clicked(31); } }
                Rectangle { width: 4px; }
                Keycap { label: "E"; key-width: 32px; led-color: root.resolved-color(32); has-led: root.key-active(32); is-selected: root.selected-key-idx == 32; is-remapped: root.key-remapped(32); clicked => { root.key-clicked(32); } }
                Rectangle { width: 4px; }
                Keycap { label: "R"; key-width: 32px; led-color: root.resolved-color(33); has-led: root.key-active(33); is-selected: root.selected-key-idx == 33; is-remapped: root.key-remapped(33); clicked => { root.key-clicked(33); } }
                Rectangle { width: 4px; }
                Keycap { label: "T"; key-width: 32px; led-color: root.resolved-color(34); has-led: root.key-active(34); is-selected: root.selected-key-idx == 34; is-remapped: root.key-remapped(34); clicked => { root.key-clicked(34); } }
                Rectangle { width: 4px; }
                Keycap { label: "Y"; key-width: 32px; led-color: root.resolved-color(35); has-led: root.key-active(35); is-selected: root.selected-key-idx == 35; is-remapped: root.key-remapped(35); clicked => { root.key-clicked(35); } }
                Rectangle { width: 4px; }
                Keycap { label: "U"; key-width: 32px; led-color: root.resolved-color(36); has-led: root.key-active(36); is-selected: root.selected-key-idx == 36; is-remapped: root.key-remapped(36); clicked => { root.key-clicked(36); } }
                Rectangle { width: 4px; }
                Keycap { label: "I"; key-width: 32px; led-color: root.resolved-color(37); has-led: root.key-active(37); is-selected: root.selected-key-idx == 37; is-remapped: root.key-remapped(37); clicked => { root.key-clicked(37); } }
                Rectangle { width: 4px; }
                Keycap { label: "O"; key-width: 32px; led-color: root.resolved-color(38); has-led: root.key-active(38); is-selected: root.selected-key-idx == 38; is-remapped: root.key-remapped(38); clicked => { root.key-clicked(38); } }
                Rectangle { width: 4px; }
                Keycap { label: "P"; key-width: 32px; led-color: root.resolved-color(39); has-led: root.key-active(39); is-selected: root.selected-key-idx == 39; is-remapped: root.key-remapped(39); clicked => { root.key-clicked(39); } }
                Rectangle { width: 4px; }
                Keycap { label: "["; key-width: 32px; led-color: root.resolved-color(40); has-led: root.key-active(40); is-selected: root.selected-key-idx == 40; is-remapped: root.key-remapped(40); clicked => { root.key-clicked(40); } }
                Rectangle { width: 4px; }
                Keycap { label: "]"; key-width: 32px; led-color: root.resolved-color(41); has-led: root.key-active(41); is-selected: root.selected-key-idx == 41; is-remapped: root.key-remapped(41); clicked => { root.key-clicked(41); } }
                Rectangle { width: 4px; }
                Keycap { label: "\\"; key-width: 50px; led-color: root.resolved-color(42); has-led: root.key-active(42); is-selected: root.selected-key-idx == 42; is-remapped: root.key-remapped(42); clicked => { root.key-clicked(42); } }
                Rectangle { width: 4px; }
                Keycap { label: "PGUP"; key-width: 32px; led-color: root.resolved-color(43); has-led: root.key-active(43); is-selected: root.selected-key-idx == 43; is-remapped: root.key-remapped(43); clicked => { root.key-clicked(43); } }
            }

            // Row 3: CAPS(44) + A..'(55) + ENTER(56) + PGDN(57)
            HorizontalLayout {
                spacing: 0px;
                alignment: start;

                Keycap { label: "CAPS"; key-width: 58px; led-color: root.resolved-color(44); has-led: root.key-active(44); is-selected: root.selected-key-idx == 44; is-remapped: root.key-remapped(44); clicked => { root.key-clicked(44); } }
                Rectangle { width: 4px; }
                Keycap { label: "A"; key-width: 32px; led-color: root.resolved-color(45); has-led: root.key-active(45); is-selected: root.selected-key-idx == 45; is-remapped: root.key-remapped(45); clicked => { root.key-clicked(45); } }
                Rectangle { width: 4px; }
                Keycap { label: "S"; key-width: 32px; led-color: root.resolved-color(46); has-led: root.key-active(46); is-selected: root.selected-key-idx == 46; is-remapped: root.key-remapped(46); clicked => { root.key-clicked(46); } }
                Rectangle { width: 4px; }
                Keycap { label: "D"; key-width: 32px; led-color: root.resolved-color(47); has-led: root.key-active(47); is-selected: root.selected-key-idx == 47; is-remapped: root.key-remapped(47); clicked => { root.key-clicked(47); } }
                Rectangle { width: 4px; }
                Keycap { label: "F"; key-width: 32px; led-color: root.resolved-color(48); has-led: root.key-active(48); is-selected: root.selected-key-idx == 48; is-remapped: root.key-remapped(48); clicked => { root.key-clicked(48); } }
                Rectangle { width: 4px; }
                Keycap { label: "G"; key-width: 32px; led-color: root.resolved-color(49); has-led: root.key-active(49); is-selected: root.selected-key-idx == 49; is-remapped: root.key-remapped(49); clicked => { root.key-clicked(49); } }
                Rectangle { width: 4px; }
                Keycap { label: "H"; key-width: 32px; led-color: root.resolved-color(50); has-led: root.key-active(50); is-selected: root.selected-key-idx == 50; is-remapped: root.key-remapped(50); clicked => { root.key-clicked(50); } }
                Rectangle { width: 4px; }
                Keycap { label: "J"; key-width: 32px; led-color: root.resolved-color(51); has-led: root.key-active(51); is-selected: root.selected-key-idx == 51; is-remapped: root.key-remapped(51); clicked => { root.key-clicked(51); } }
                Rectangle { width: 4px; }
                Keycap { label: "K"; key-width: 32px; led-color: root.resolved-color(52); has-led: root.key-active(52); is-selected: root.selected-key-idx == 52; is-remapped: root.key-remapped(52); clicked => { root.key-clicked(52); } }
                Rectangle { width: 4px; }
                Keycap { label: "L"; key-width: 32px; led-color: root.resolved-color(53); has-led: root.key-active(53); is-selected: root.selected-key-idx == 53; is-remapped: root.key-remapped(53); clicked => { root.key-clicked(53); } }
                Rectangle { width: 4px; }
                Keycap { label: ";"; key-width: 32px; led-color: root.resolved-color(54); has-led: root.key-active(54); is-selected: root.selected-key-idx == 54; is-remapped: root.key-remapped(54); clicked => { root.key-clicked(54); } }
