import { Theme } from "theme.slint";
import { Keycap } from "keycap.slint";

export component KeyboardView inherits Rectangle {
    in property <color> global-led-color: #000000;
    in property <bool> has-led: false;
    in property <string> chattering-key: "";

    callback key-clicked(string);

    width: 604px; // 572px de teclas + 32px de padding (16px de cada lado)
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-color: Theme.border;
    border-width: 1px;

    VerticalLayout {
        padding: 16px;
        spacing: 5px;
        alignment: start;

        // Row 0: Esc + F1-F12 + Del + Knob (Total = 572px)
        HorizontalLayout {
            spacing: 0px;
            alignment: start;

            Keycap { label: "ESC"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; has-chattering: root.chattering-key == "ESC"; clicked => { root.key-clicked("ESC"); } }
            Rectangle { width: 10px; }

            Keycap { label: "F1"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("F1"); } }
            Rectangle { width: 4px; }
            Keycap { label: "F2"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("F2"); } }
            Rectangle { width: 4px; }
            Keycap { label: "F3"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("F3"); } }
            Rectangle { width: 4px; }
            Keycap { label: "F4"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("F4"); } }
            Rectangle { width: 10px; }

            Keycap { label: "F5"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("F5"); } }
            Rectangle { width: 4px; }
            Keycap { label: "F6"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("F6"); } }
            Rectangle { width: 4px; }
            Keycap { label: "F7"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("F7"); } }
            Rectangle { width: 4px; }
            Keycap { label: "F8"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("F8"); } }
            Rectangle { width: 10px; }

            Keycap { label: "F9"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("F9"); } }
            Rectangle { width: 4px; }
            Keycap { label: "F10"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("F10"); } }
            Rectangle { width: 4px; }
            Keycap { label: "F11"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("F11"); } }
            Rectangle { width: 4px; }
            Keycap { label: "F12"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("F12"); } }
            Rectangle { width: 10px; }

            Keycap { label: "DEL"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("DEL"); } }
            Rectangle { width: 14px; }
            Keycap { label: ""; key-width: 34px; is-knob: true; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("KNOB"); } }
        }

        // Row 1: Number Row + Backspace + Home (Total = 572px)
        HorizontalLayout {
            spacing: 0px;
            alignment: start;

            Keycap { label: "`"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("`"); } }
            Rectangle { width: 4px; }
            Keycap { label: "1"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("1"); } }
            Rectangle { width: 4px; }
            Keycap { label: "2"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("2"); } }
            Rectangle { width: 4px; }
            Keycap { label: "3"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("3"); } }
            Rectangle { width: 4px; }
            Keycap { label: "4"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("4"); } }
            Rectangle { width: 4px; }
            Keycap { label: "5"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("5"); } }
            Rectangle { width: 4px; }
            Keycap { label: "6"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("6"); } }
            Rectangle { width: 4px; }
            Keycap { label: "7"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("7"); } }
            Rectangle { width: 4px; }
            Keycap { label: "8"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("8"); } }
            Rectangle { width: 4px; }
            Keycap { label: "9"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("9"); } }
            Rectangle { width: 4px; }
            Keycap { label: "0"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("0"); } }
            Rectangle { width: 4px; }
            Keycap { label: "-"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("-"); } }
            Rectangle { width: 4px; }
            Keycap { label: "="; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("="); } }
            Rectangle { width: 4px; }
            Keycap { label: "BKSP"; key-width: 68px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("BKSP"); } }
            Rectangle { width: 4px; }
            Keycap { label: "HOME"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("HOME"); } }
        }

        // Row 2: Tab + QWERTY + PgUp (Total = 572px)
        HorizontalLayout {
            spacing: 0px;
            alignment: start;

            Keycap { label: "TAB"; key-width: 50px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("TAB"); } }
            Rectangle { width: 4px; }
            Keycap { label: "Q"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("Q"); } }
            Rectangle { width: 4px; }
            Keycap { label: "W"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("W"); } }
            Rectangle { width: 4px; }
            Keycap { label: "E"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("E"); } }
            Rectangle { width: 4px; }
            Keycap { label: "R"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("R"); } }
            Rectangle { width: 4px; }
            Keycap { label: "T"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("T"); } }
            Rectangle { width: 4px; }
            Keycap { label: "Y"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("Y"); } }
            Rectangle { width: 4px; }
            Keycap { label: "U"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("U"); } }
            Rectangle { width: 4px; }
            Keycap { label: "I"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("I"); } }
            Rectangle { width: 4px; }
            Keycap { label: "O"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("O"); } }
            Rectangle { width: 4px; }
            Keycap { label: "P"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("P"); } }
            Rectangle { width: 4px; }
            Keycap { label: "["; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("["); } }
            Rectangle { width: 4px; }
            Keycap { label: "]"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("]"); } }
            Rectangle { width: 4px; }
            Keycap { label: "\\"; key-width: 50px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("\\"); } }
            Rectangle { width: 4px; }
            Keycap { label: "PGUP"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("PGUP"); } }
        }

        // Row 3: CapsLock + ASDF + Enter + PgDn (Total = 572px)
        HorizontalLayout {
            spacing: 0px;
            alignment: start;

            Keycap { label: "CAPS"; key-width: 58px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("CAPS"); } }
            Rectangle { width: 4px; }
            Keycap { label: "A"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("A"); } }
            Rectangle { width: 4px; }
            Keycap { label: "S"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("S"); } }
            Rectangle { width: 4px; }
            Keycap { label: "D"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("D"); } }
            Rectangle { width: 4px; }
            Keycap { label: "F"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("F"); } }
            Rectangle { width: 4px; }
            Keycap { label: "G"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("G"); } }
            Rectangle { width: 4px; }
            Keycap { label: "H"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("H"); } }
            Rectangle { width: 4px; }
            Keycap { label: "J"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("J"); } }
            Rectangle { width: 4px; }
            Keycap { label: "K"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("K"); } }
            Rectangle { width: 4px; }
            Keycap { label: "L"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("L"); } }
            Rectangle { width: 4px; }
            Keycap { label: ";"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked(";"); } }
            Rectangle { width: 4px; }
            Keycap { label: "'"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("'"); } }
            Rectangle { width: 4px; }
            Keycap { label: "ENTER"; key-width: 78px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("ENTER"); } }
            Rectangle { width: 4px; }
            Keycap { label: "PGDN"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("PGDN"); } }
        }

        // Row 4: LShift + ZXCV + RShift + Up + End (Total = 572px)
        HorizontalLayout {
            spacing: 0px;
            alignment: start;

            Keycap { label: "SHIFT"; key-width: 76px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("LSHIFT"); } }
            Rectangle { width: 4px; }
            Keycap { label: "Z"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("Z"); } }
            Rectangle { width: 4px; }
            Keycap { label: "X"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("X"); } }
            Rectangle { width: 4px; }
            Keycap { label: "C"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("C"); } }
            Rectangle { width: 4px; }
            Keycap { label: "V"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("V"); } }
            Rectangle { width: 4px; }
            Keycap { label: "B"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("B"); } }
            Rectangle { width: 4px; }
            Keycap { label: "N"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("N"); } }
            Rectangle { width: 4px; }
            Keycap { label: "M"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("M"); } }
            Rectangle { width: 4px; }
            Keycap { label: ","; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked(","); } }
            Rectangle { width: 4px; }
            Keycap { label: "."; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("."); } }
            Rectangle { width: 4px; }
            Keycap { label: "/"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("/"); } }
            Rectangle { width: 4px; }
            Keycap { label: "SHIFT"; key-width: 60px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("RSHIFT"); } }

            // Seta para cima (Up) perfeitamente alinhada acima da seta para baixo
            Rectangle { width: 4px; }
            Keycap { label: "▲"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("UP"); } }
            Rectangle { width: 4px; }
            Keycap { label: "END"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("END"); } }
        }

        // Row 5: Modifiers + Space + Arrows (Left, Down, Right) (Total = 572px)
        HorizontalLayout {
            spacing: 0px;
            alignment: start;

            Keycap { label: "CTRL"; key-width: 41px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("LCTRL"); } }
            Rectangle { width: 4px; }
            Keycap { label: "WIN"; key-width: 41px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("WIN"); } }
            Rectangle { width: 4px; }
            Keycap { label: "ALT"; key-width: 41px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("LALT"); } }
            Rectangle { width: 4px; }
            Keycap { label: ""; key-width: 225px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("SPACE"); } }
            Rectangle { width: 4px; }
            Keycap { label: "ALT"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("RALT"); } }
            Rectangle { width: 4px; }
            Keycap { label: "FN"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("FN"); } }
            Rectangle { width: 4px; }
            Keycap { label: "CTRL"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("RCTRL"); } }

            // Bloco de setas: Left, Down (embaixo de Up), Right (embaixo de End)
            Rectangle { width: 4px; }
            Keycap { label: "◄"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("LEFT"); } }
            Rectangle { width: 4px; }
            Keycap { label: "▼"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("DOWN"); } }
            Rectangle { width: 4px; }
            Keycap { label: "►"; key-width: 32px; led-color: root.global-led-color; has-led: root.has-led; clicked => { root.key-clicked("RIGHT"); } }
        }
    }
}
