import { Theme } from "theme.slint";

export component SidebarItem inherits Rectangle {
    in property <image> icon;
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <bool> is-active: false;

    callback clicked();

    height: 48px;
    border-radius: Theme.radius-md;
    background: root.is-active ? Theme.surface-active : (touch.has-hover ? Theme.surface-hover : #00000000);
    border-color: root.is-active ? Theme.border-light : #00000000;
    border-width: 1px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        alignment: start; // Alinhamento à esquerda estrito para todos os itens

        // Ícone SVG monocromático
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: Theme.radius-sm;
                background: root.is-active ? Theme.surface-raised : Theme.surface;
                border-color: root.is-active ? Theme.border-light : Theme.border;
                border-width: 1px;

                Image {
                    source: root.icon;
                    width: 15px;
                    height: 15px;
                    colorize: root.is-active ? Theme.text-primary : Theme.text-secondary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Títulos
        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-family: Theme.mono-font;
                font-size: 11px;
                font-weight: 600;
                color: root.is-active ? Theme.text-primary : Theme.text-secondary;
            }

            if (root.subtitle != "") : Text {
                text: root.subtitle;
                font-family: Theme.mono-font;
                font-size: 9px;
                color: Theme.text-muted;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Sidebar inherits Rectangle {
    in-out property <int> active-tab: 0;
    in property <bool> daemon-online: true;
    in property <string> mouse-subtitle: "Desconectado";

    callback tab-changed(int);

    width: 220px;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // Header / Logo
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            padding-left: 4px;
            padding-bottom: 8px;

            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("assets/logo.svg");
                    width: 26px;
                    height: 26px;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: "AJAZZ SUITE";
                    font-family: Theme.mono-font;
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-primary;
                }
                Text {
                    text: "UNIFIED COMPANION";
                    font-family: Theme.mono-font;
                    font-size: 8px;
                    color: Theme.text-muted;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        Rectangle { height: 4px; }

        // Navegação
        SidebarItem {
            icon: @image-url("assets/icon_keyboard.svg");
            title: "AK820 RGB";
            subtitle: "75% Mechanical";
            is-active: root.active-tab == 0;
            clicked => {
                root.active-tab = 0;
                root.tab-changed(0);
            }
        }

        SidebarItem {
            icon: @image-url("assets/icon_mouse.svg");
            title: "AJ179 NL P";
            subtitle: root.mouse-subtitle;
            is-active: root.active-tab == 1;
            clicked => {
                root.active-tab = 1;
                root.tab-changed(1);
            }
        }

        SidebarItem {
            icon: @image-url("assets/icon_settings.svg");
            title: "CONFIGURAÇÕES";
            subtitle: "Daemon & Sistema";
            is-active: root.active-tab == 2;
            clicked => {
                root.active-tab = 2;
                root.tab-changed(2);
            }
        }

        // Espaçador elástico empurrando o rodapé para baixo
        Rectangle { }

        // Status do Daemon no Rodapé
        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        Rectangle { height: 4px; }

        // Card de Status do Daemon
        Rectangle {
            height: 48px;
            border-radius: Theme.radius-sm;
            background: Theme.surface-raised;
            border-color: Theme.border;
            border-width: 1px;

            VerticalLayout {
                alignment: center;
                spacing: 4px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: root.daemon-online ? Theme.status-online : Theme.status-warning;
                        }
                    }

                    Text {
                        text: root.daemon-online ? "DAEMON ONLINE" : "RECONECTANDO...";
                        font-family: Theme.mono-font;
                        font-size: 9px;
                        font-weight: 700;
                        color: root.daemon-online ? Theme.text-primary : Theme.status-warning;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "\\\\.\\pipe\\ajazz-daemon";
                    font-family: Theme.mono-font;
                    font-size: 8px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
