import { Theme } from "theme.slint";
import { Sidebar } from "sidebar.slint";
import { KeyboardView } from "keyboard_view.slint";
import { LightingControls } from "lighting_controls.slint";
import { KeymapControls } from "keymap_controls.slint";
import { MacroControls, MacroStepItem } from "macro_controls.slint";
import { SystemControls } from "system_controls.slint";
import { KeyboardDiagControls, KeyboardChatterRowItem } from "keyboard_diag.slint";
import { MouseView, MouseChatterRowItem } from "mouse_view.slint";
import { SettingsView } from "settings_view.slint";

export { MacroStepItem, MouseChatterRowItem, KeyboardChatterRowItem }

component SubTabPill inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <length> pill-width: 100px;
    callback clicked();

    width: root.pill-width;
    height: 24px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.surface-active : (ta.has-hover ? Theme.surface-hover : Theme.surface);
    border-color: root.active ? Theme.border-light : Theme.border;
    border-width: 1px;

    Text {
        text: root.label;
        font-family: Theme.mono-font;
        font-size: 9px;
        font-weight: root.active ? 700 : 500;
        color: root.active ? Theme.text-primary : Theme.text-secondary;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ModalActionBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <length> btn-width: 72px;
    callback clicked();

    width: root.btn-width;
    height: 22px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.surface-active : (ta.has-hover ? Theme.surface-hover : Theme.surface-raised);
    border-color: root.active ? Theme.border-light : Theme.border;
    border-width: 1px;

    Text {
        text: root.label;
        font-family: Theme.mono-font;
        font-size: 9px;
        font-weight: root.active ? 700 : 500;
        color: root.active ? Theme.text-primary : Theme.text-secondary;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "AJAZZ Companion Suite";
    icon: @image-url("assets/logo.svg");
    default-font-family: "JetBrains Mono";
    preferred-width: 980px;
    preferred-height: 680px;
    min-width: 980px;
    max-width: 980px;
    min-height: 680px;
    max-height: 680px;
    background: Theme.background;

    // Estado da aplicação e User Profile sincronizado com Daemon
    in-out property <int> active-tab: 0;
    in-out property <int> kb-subtab: 0; // 0=Iluminação, 1=Remap, 2=Macros, 3=Sistema
    in-out property <bool> daemon-online: false;
    in-out property <bool> device-connected: false;
    in-out property <string> chattering-alert: "";
    in-out property <string> feedback-text: "";
    in-out property <bool> feedback-is-error: false;

    // Estado de Keymap
    in-out property <int> selected-key-idx: 0;
    in-out property <[bool]> remapped-keys: [];
    in-out property <string> km-selected-key-name: "ESC";
    in-out property <string> km-current-binding: "Padrão: Esc";
    in-out property <bool> km-selected-remapped: false;
    in-out property <int> km-draft-category: 0;
    in-out property <int> km-draft-mod-mask: 0;
    in-out property <int> km-draft-key-idx: 0;
    in-out property <int> km-draft-mouse-idx: 0;
    in-out property <int> km-draft-extra-idx: 0;
    in-out property <int> km-draft-macro-idx: 0;
    in-out property <int> km-draft-macro-mode: 0;
    in-out property <int> km-draft-macro-repeat: 2;
    in-out property <bool> km-capturing-key: false;
    in-out property <[string]> km-key-catalog-labels: [];
    in-out property <[string]> km-extra-action-labels: [];

    // Estado de Macros
    in-out property <[string]> macro-names: [];
    in-out property <int> macro-selected-idx: -1;
    in-out property <string> macro-draft-name: "";
    in-out property <[MacroStepItem]> macro-draft-steps: [];
    in-out property <bool> macro-recording: false;
    in-out property <bool> macro-use-fixed-delay: false;
    in-out property <string> macro-fixed-delay-text: "25";

    // Estado de SystemStages (0x05 / 0x06)
    in-out property <bool> sys-win-lock: false;
    in-out property <bool> sys-wasd-swap: false;
    in-out property <int> sys-polling-rate-idx: 0;

    in-out property <[string]> mode-labels: [
        "Normal", "Corrugated", "Cloud", "Serpentine", "Spectrum", "Breath", "Reaction",
        "Ripples", "Traverse", "Stars", "Flowers", "Roll", "Wave", "Cartoon",
        "Rain", "Scan", "Surmount", "Speed", "Capture", "Audio", "Custom"
    ];
    in-out property <int> active-mode-index: 0;
    in-out property <int> brightness: 4;
    in-out property <int> speed: 2;
    in-out property <int> direction: 0;
    in-out property <bool> multicolor: false;
    in-out property <int> zzcc-mode: 0;
    in-out property <int> custom-bank: 0;
    in-out property <bool> custom-eraser: false;
    in-out property <int> audio-style: 0;
    in-out property <bool> audio-bg-enabled: false;
    in-out property <color> audio-bg-color: #000000;
    in-out property <string> gif-file-name: "Nenhum .gif selecionado";
    in-out property <bool> gif-has-file: false;
    in-out property <int> gif-fps: 25;
    in-out property <bool> is-playing-gif: false;

    in-out property <color> current-color: #FF0000;
    in-out property <string> hex-text: "#FF0000";
    in-out property <string> red-text: "255";
    in-out property <string> green-text: "0";
    in-out property <string> blue-text: "0";
    in-out property <[color]> key-colors: [];

    // Capacidades dinâmicas por modo
    in-out property <bool> supports-color: true;
    in-out property <bool> supports-multicolor: true;
    in-out property <bool> supports-speed: false;
    in-out property <bool> supports-direction: false;
    in-out property <string> dir-primary-label: "L → R";
    in-out property <string> dir-reverse-label: "R → L";
    in-out property <bool> supports-zzcc: false;
    in-out property <bool> is-custom-mode: false;
    in-out property <bool> is-audio-mode: false;

    // Popover HSV sob demanda
    in-out property <bool> hsv-popover-open: false;
    in-out property <image> hsv-sv-image;
    in-out property <image> hsv-hue-image;
    in-out property <float> hsv-h: 0.0;
    in-out property <float> hsv-s: 1.0;
    in-out property <float> hsv-v: 1.0;

    // Modal de Enquadramento / Velocidade GIF sob demanda
    in-out property <bool> gif-crop-modal-open: false;
    in-out property <image> gif-preview-image;
    in-out property <float> gif-preview-w: 320.0;
    in-out property <float> gif-preview-h: 180.0;
    in-out property <float> gif-crop-x: 0.0;
    in-out property <float> gif-crop-y: 0.0;
    in-out property <float> gif-crop-w: 1.0;
    in-out property <float> gif-crop-h: 1.0;
    in-out property <string> gif-crop-info-text: "100%";

    // Callbacks para o backend Rust
    callback mode-selected(int);
    callback brightness-changed(int);
    callback speed-changed(int);
    callback direction-changed(int);
    callback multicolor-toggled(bool);
    callback zzcc-changed(int);
    callback custom-bank-selected(int);
    callback custom-key-clicked(int, bool);
    callback custom-fill-all();
    callback custom-clear-all();
    callback audio-style-selected(int);
    callback audio-bg-toggled(bool);
    callback audio-bg-use-current();
    callback gif-browse-clicked();
    callback gif-fps-selected(int);
    callback gif-play-toggle();
    callback gif-crop-open-clicked();
    callback gif-crop-pan(float, float);
    callback gif-crop-zoom(float);
    callback gif-crop-fit-keyboard();
    callback gif-crop-reset();
    callback gif-crop-applied();
    callback swatch-clicked(color);
    callback hex-submitted(string);
    callback rgb-submitted(string, string, string);
    callback hsv-sv-updated(float, float);
    callback hsv-hue-updated(float);
    callback hsv-committed();
    callback open-hsv-popover();
    callback apply-clicked();
    callback reconnect-daemon();

    // Callbacks Keymap / Macros / Sistema
    callback keymap-key-clicked(int);
    callback km-category-selected(int);
    callback km-toggle-modifier(int);
    callback km-select-catalog-key(int);
    callback km-capture-key-pressed(string, bool, bool, bool, bool);
    callback km-select-mouse-button(int);
    callback km-select-extra-action(int);
    callback km-select-macro(int);
    callback km-select-macro-mode(int);
    callback km-change-macro-repeat(int);
    callback km-apply-clicked();
    callback km-reset-key-clicked();
    callback km-reset-all-clicked();

    callback macro-select(int);
    callback macro-new-clicked();
    callback macro-delete-clicked();
    callback macro-save-clicked(string);
    callback macro-clear-steps-clicked();
    callback macro-toggle-recording(bool);
    callback macro-record-key-event(string, bool, bool, bool, bool, bool);
    callback macro-record-mouse-event(int, bool);
    callback macro-add-mouse-click(int);
    callback macro-add-mouse-move(string, string);
    callback macro-adjust-step-delay(int, int);
    callback macro-remove-step(int);

    callback sys-toggle-win-lock(bool);
    callback sys-toggle-wasd-swap(bool);
    callback sys-select-polling-rate(int);
    callback sys-sync-from-device();
    callback sys-reset-keymap-factory();

    // Diagnóstico passivo de Switch Chattering no teclado
    in-out property <bool> kb-chatter-enabled: false;
    in-out property <int> kb-chatter-threshold-ms: 45;
    in-out property <int> kb-chatter-total: 0;
    in-out property <string> kb-chatter-alert-text: "Monitor pausado pelo usuário.";
    in-out property <[KeyboardChatterRowItem]> kb-chatter-rows: [];
    callback kb-chatter-toggle-clicked();
    callback kb-chatter-threshold-step(int);
    callback kb-chatter-reset-clicked();

    // Autostart do Daemon no Windows
    in-out property <bool> autostart-enabled: false;
    callback autostart-toggled();

    // Estado e callbacks do Mouse AJ179 NL P
    in-out property <string> sidebar-mouse-subtitle: "Desconectado";
    in-out property <bool> ms-connected: false;
    in-out property <bool> ms-online: false;
    in-out property <bool> ms-charging: false;
    in-out property <int> ms-battery-percent: 0;
    in-out property <string> ms-conn-label: "OFFLINE";
    in-out property <string> ms-fw-label: "VID 0x7768 • UsagePage 0xFFB2";
    in-out property <string> ms-feedback-text: "";
    in-out property <bool> ms-feedback-is-error: false;
    in-out property <int> ms-subtab: 0;
    in-out property <bool> ms-dirty: false;

    in-out property <int> ms-dpi-count: 4;
    in-out property <int> ms-dpi-index: 1;
    in-out property <[int]> ms-dpi-values: [400, 800, 1600, 3200, 6400, 12800];
    in-out property <[string]> ms-dpi-texts: ["400", "800", "1600", "3200", "6400", "12800"];
    in-out property <int> ms-polling-idx: 3;
    in-out property <int> ms-lod-idx: 0;
    in-out property <bool> ms-motion-sync: true;
    in-out property <bool> ms-ripple-control: false;
    in-out property <bool> ms-linear-correction: false;
    in-out property <bool> ms-highspeed: true;
    in-out property <int> ms-debounce-ms: 8;

    in-out property <int> ms-scroll-idx: 0;
    in-out property <int> ms-light-sleep: 60;
    in-out property <int> ms-deep-sleep: 300;
    in-out property <string> ms-light-sleep-label: "1 min";
    in-out property <string> ms-deep-sleep-label: "5 min";

    in-out property <[string]> ms-button-labels: ["Clique Esq.", "Clique Dir.", "Botão Meio", "Avançar", "Voltar"];
    in-out property <int> ms-selected-slot: 0;
    in-out property <string> ms-slot-title: "[0] CLIQUE ESQUERDO";
    in-out property <string> ms-slot-current-binding: "Clique Esq.";
    in-out property <int> ms-btn-category: 0;
    in-out property <int> ms-btn-mouse-idx: 0;
    in-out property <int> ms-btn-mod-mask: 0;
    in-out property <int> ms-btn-key-idx: 0;
    in-out property <int> ms-btn-media-idx: 0;
    in-out property <int> ms-btn-system-idx: 0;
    in-out property <int> ms-btn-macro-idx: 0;
    in-out property <int> ms-btn-macro-mode: 0;
    in-out property <int> ms-btn-macro-repeat: 1;
    in-out property <bool> ms-btn-capturing-key: false;
    in-out property <bool> ms-btn-left-warning: false;
    in property <[string]> ms-media-labels: [];
    in-out property <bool> ms-chatter-enabled: true;
    in-out property <int> ms-chatter-threshold-ms: 45;
    in-out property <int> ms-chatter-total: 0;
    in-out property <string> ms-chatter-alert-text: "Nenhum rebote anormal detectado nos switches físicos.";
    in-out property <[MouseChatterRowItem]> ms-chatter-rows: [];

    callback ms-dpi-count-changed(int);
    callback ms-dpi-stage-selected(int);
    callback ms-dpi-step(int, int);
    callback ms-dpi-text-edited(int, string);
    callback ms-dpi-text-committed(int, string);
    callback ms-polling-selected(int);
    callback ms-lod-selected(int);
    callback ms-sensor-toggled(int);
    callback ms-highspeed-toggled();
    callback ms-debounce-step(int);
    callback ms-debounce-set(int);
    callback ms-scroll-selected(int);
    callback ms-light-sleep-selected(int);
    callback ms-deep-sleep-selected(int);
    callback ms-apply-config-clicked();
    callback ms-sync-clicked();
    callback ms-start-pairing-clicked();
    callback ms-slot-selected(int);
    callback ms-btn-category-selected(int);
    callback ms-btn-mouse-selected(int);
    callback ms-btn-toggle-modifier(int);
    callback ms-btn-catalog-key-selected(int);
    callback ms-btn-capture-key(string, bool, bool, bool, bool);
    callback ms-btn-media-selected(int);
    callback ms-btn-system-selected(int);
    callback ms-btn-macro-selected(int);
    callback ms-btn-macro-mode-selected(int);
    callback ms-btn-macro-repeat-step(int);
    callback ms-apply-button-clicked();
    callback ms-reset-buttons-clicked();
    callback ms-chatter-toggle-clicked();
    callback ms-chatter-threshold-step(int);
    callback ms-chatter-reset-clicked();

    HorizontalLayout {
        Sidebar {
            active-tab <=> root.active-tab;
            daemon-online: root.daemon-online;
            mouse-subtitle: root.sidebar-mouse-subtitle;
        }

        Rectangle {
            background: Theme.background;

            // Aba 0: Teclado AK820
            if (root.active-tab == 0) : VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;
                alignment: start;

                // Título e status do hardware
                HorizontalLayout {
                    width: 720px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 1px;
                        alignment: center;
                        Text {
                            text: "AJAZZ AK820 75% MECHANICAL KEYBOARD";
                            font-family: Theme.mono-font;
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }
                        Text {
                            width: 490px;
                            text: root.feedback-text != ""
                                ? root.feedback-text
                                : "EVision Semiconductor (VID 0x320F / PID 0x505B) • UsagePage 0xFF1C";
                            font-family: Theme.mono-font;
                            font-size: 9px;
                            color: root.feedback-is-error ? Theme.status-error : (root.feedback-text != "" ? Theme.status-online : Theme.text-secondary);
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        height: 24px;
                        border-radius: Theme.radius-sm;
                        background: Theme.surface;
                        border-color: Theme.border;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: root.device-connected ? Theme.status-online : (root.daemon-online ? Theme.status-warning : Theme.status-error);
                                }
                            }

                            Text {
                                text: root.device-connected ? "CONECTADO" : (root.daemon-online ? "SEM TECLADO" : "DAEMON OFFLINE");
                                font-family: Theme.mono-font;
                                font-size: 9px;
                                font-weight: 700;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Barra de Sub-abas do Teclado
                HorizontalLayout {
                    width: 720px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 6px;
                        SubTabPill { label: "Iluminação"; pill-width: 96px; active: root.kb-subtab == 0; clicked => { root.km-capturing-key = false; root.macro-recording = false; root.kb-subtab = 0; } }
                        SubTabPill { label: "Remapear Teclas"; pill-width: 112px; active: root.kb-subtab == 1; clicked => { root.macro-recording = false; root.kb-subtab = 1; } }
                        SubTabPill { label: "Macros"; pill-width: 82px; active: root.kb-subtab == 2; clicked => { root.km-capturing-key = false; root.kb-subtab = 2; } }
                        SubTabPill { label: "Sistema"; pill-width: 82px; active: root.kb-subtab == 3; clicked => { root.km-capturing-key = false; root.macro-recording = false; root.kb-subtab = 3; } }
                        SubTabPill { label: "Diagnóstico"; pill-width: 98px; active: root.kb-subtab == 4; clicked => { root.km-capturing-key = false; root.macro-recording = false; root.kb-subtab = 4; } }
                    }

                    if (root.sys-wasd-swap) : Rectangle {
                        height: 24px;
                        width: 170px;
                        border-radius: Theme.radius-sm;
                        background: #3B3219;
                        border-color: Theme.status-warning;
                        border-width: 1px;

                        Text {
                            text: "⚠ WASD ↔ SETAS ATIVO";
                            font-family: Theme.mono-font;
                            font-size: 8px;
                            font-weight: 700;
                            color: Theme.status-warning;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                // Layout Vetorial Físico das 82 Teclas
                KeyboardView {
                    global-led-color: root.current-color;
                    has-led: root.brightness > 0;
                    key-colors: root.key-colors;
                    chattering-key: root.chattering-alert;
                    selected-key-idx: root.kb-subtab == 1 ? root.selected-key-idx : -1;
                    remapped-keys: root.remapped-keys;
                    key-clicked(key-idx) => {
                        if (root.kb-subtab == 0 && root.is-custom-mode) {
                            root.custom-key-clicked(key-idx, root.custom-eraser);
                        } else if (root.kb-subtab == 1) {
                            root.keymap-key-clicked(key-idx);
                        }
                    }
                }

                // Sub-aba 0: Painel de Controles de Iluminação
                if (root.kb-subtab == 0) : LightingControls {
                    mode-labels: root.mode-labels;
                    active-mode-index <=> root.active-mode-index;
                    brightness <=> root.brightness;
                    speed <=> root.speed;
                    direction <=> root.direction;
                    multicolor <=> root.multicolor;
                    zzcc-mode <=> root.zzcc-mode;
                    custom-bank <=> root.custom-bank;
                    custom-eraser <=> root.custom-eraser;
                    audio-style <=> root.audio-style;
                    audio-bg-enabled <=> root.audio-bg-enabled;
                    audio-bg-color <=> root.audio-bg-color;
                    gif-file-name <=> root.gif-file-name;
                    gif-has-file <=> root.gif-has-file;
                    gif-fps <=> root.gif-fps;
                    is-playing-gif <=> root.is-playing-gif;
                    selected-color <=> root.current-color;
                    hex-text <=> root.hex-text;
                    red-text <=> root.red-text;
                    green-text <=> root.green-text;
                    blue-text <=> root.blue-text;
                    supports-color: root.supports-color;
                    supports-multicolor: root.supports-multicolor;
                    supports-speed: root.supports-speed;
                    supports-direction: root.supports-direction;
                    dir-primary-label: root.dir-primary-label;
                    dir-reverse-label: root.dir-reverse-label;
                    supports-zzcc: root.supports-zzcc;
                    is-custom-mode: root.is-custom-mode;
                    is-audio-mode: root.is-audio-mode;

                    mode-selected(idx) => { root.mode-selected(idx); }
                    brightness-changed(val) => { root.brightness-changed(val); }
                    speed-changed(val) => { root.speed-changed(val); }
                    direction-changed(val) => { root.direction-changed(val); }
                    multicolor-toggled(val) => { root.multicolor-toggled(val); }
                    zzcc-changed(val) => { root.zzcc-changed(val); }
                    custom-bank-selected(b) => { root.custom-bank-selected(b); }
                    custom-fill-all => { root.custom-fill-all(); }
                    custom-clear-all => { root.custom-clear-all(); }
                    audio-style-selected(s) => { root.audio-style-selected(s); }
                    audio-bg-toggled(en) => { root.audio-bg-toggled(en); }
                    audio-bg-use-current => { root.audio-bg-use-current(); }
                    gif-browse-clicked => { root.gif-browse-clicked(); }
                    gif-fps-selected(fps) => { root.gif-fps-selected(fps); }
                    gif-play-toggle => { root.gif-play-toggle(); }
                    gif-crop-open-clicked => { root.gif-crop-open-clicked(); }
                    swatch-clicked(c) => { root.swatch-clicked(c); }
                    hex-submitted(txt) => { root.hex-submitted(txt); }
                    rgb-submitted(r, g, b) => { root.rgb-submitted(r, g, b); }
                    open-hsv-popover => { root.open-hsv-popover(); }
                    apply-clicked => { root.apply-clicked(); }
                }

                // Sub-aba 1: Remapear Teclas
                if (root.kb-subtab == 1) : KeymapControls {
                    selected-key-idx: root.selected-key-idx;
                    selected-key-name: root.km-selected-key-name;
                    current-binding-label: root.km-current-binding;
                    is-selected-remapped: root.km-selected-remapped;
                    draft-category <=> root.km-draft-category;
                    draft-mod-mask <=> root.km-draft-mod-mask;
                    draft-key-idx <=> root.km-draft-key-idx;
                    draft-mouse-idx <=> root.km-draft-mouse-idx;
                    draft-extra-idx <=> root.km-draft-extra-idx;
                    draft-macro-idx <=> root.km-draft-macro-idx;
                    draft-macro-mode <=> root.km-draft-macro-mode;
                    draft-macro-repeat <=> root.km-draft-macro-repeat;
                    capturing-key <=> root.km-capturing-key;
                    key-catalog-labels: root.km-key-catalog-labels;
                    extra-action-labels: root.km-extra-action-labels;
                    macro-names: root.macro-names;

                    category-selected(cat) => { root.km-category-selected(cat); }
                    toggle-modifier(m) => { root.km-toggle-modifier(m); }
                    select-catalog-key(i) => { root.km-select-catalog-key(i); }
                    capture-key-pressed(t, c, s, a, m) => { root.km-capture-key-pressed(t, c, s, a, m); }
                    select-mouse-button(i) => { root.km-select-mouse-button(i); }
                    select-extra-action(i) => { root.km-select-extra-action(i); }
                    select-macro(i) => { root.km-select-macro(i); }
                    select-macro-mode(i) => { root.km-select-macro-mode(i); }
                    change-macro-repeat(d) => { root.km-change-macro-repeat(d); }
                    apply-key-clicked => { root.km-apply-clicked(); }
                    reset-key-clicked => { root.km-reset-key-clicked(); }
                    reset-all-clicked => { root.km-reset-all-clicked(); }
                }

                // Sub-aba 2: Editor e Gravador de Macros
                if (root.kb-subtab == 2) : MacroControls {
                    macro-names: root.macro-names;
                    selected-macro-idx <=> root.macro-selected-idx;
                    draft-name <=> root.macro-draft-name;
                    draft-steps: root.macro-draft-steps;
                    is-recording <=> root.macro-recording;
                    use-fixed-delay <=> root.macro-use-fixed-delay;
                    fixed-delay-text <=> root.macro-fixed-delay-text;

                    select-macro(i) => { root.macro-select(i); }
                    new-macro-clicked => { root.macro-new-clicked(); }
                    delete-macro-clicked => { root.macro-delete-clicked(); }
                    save-macro-clicked(n) => { root.macro-save-clicked(n); }
                    clear-steps-clicked => { root.macro-clear-steps-clicked(); }
                    toggle-recording(rec) => { root.macro-toggle-recording(rec); }
                    record-key-event(t, d, c, s, a, m) => { root.macro-record-key-event(t, d, c, s, a, m); }
                    record-mouse-event(b, d) => { root.macro-record-mouse-event(b, d); }
                    add-mouse-click(b) => { root.macro-add-mouse-click(b); }
                    add-mouse-move(dx, dy) => { root.macro-add-mouse-move(dx, dy); }
                    adjust-step-delay(i, delta) => { root.macro-adjust-step-delay(i, delta); }
                    remove-step(i) => { root.macro-remove-step(i); }
                }

                // Sub-aba 3: Sistema & Sincronização
                if (root.kb-subtab == 3) : SystemControls {
                    win-lock: root.sys-win-lock;
                    wasd-swap: root.sys-wasd-swap;
                    polling-rate-idx: root.sys-polling-rate-idx;

                    toggle-win-lock(v) => { root.sys-toggle-win-lock(v); }
                    toggle-wasd-swap(v) => { root.sys-toggle-wasd-swap(v); }
                    select-polling-rate(idx) => { root.sys-select-polling-rate(idx); }
                    sync-from-device-clicked => { root.sys-sync-from-device(); }
                    reset-keymap-factory-clicked => { root.sys-reset-keymap-factory(); }
                }

                // Sub-aba 4: Diagnóstico Passivo de Switch Chattering (Teclado)
                if (root.kb-subtab == 4) : KeyboardDiagControls {
                    chatter-enabled: root.kb-chatter-enabled;
                    chatter-threshold-ms: root.kb-chatter-threshold-ms;
                    chatter-total: root.kb-chatter-total;
                    chatter-alert-text: root.kb-chatter-alert-text;
                    chatter-rows: root.kb-chatter-rows;

                    toggle-clicked => { root.kb-chatter-toggle-clicked(); }
                    threshold-step(d) => { root.kb-chatter-threshold-step(d); }
                    reset-clicked => { root.kb-chatter-reset-clicked(); }
                }
            }

            // Aba 1: Mouse AJ179 NL P NearLink
            if (root.active-tab == 1) : MouseView {
                daemon-online: root.daemon-online;
                ms-connected: root.ms-connected;
                ms-online: root.ms-online;
                ms-charging: root.ms-charging;
                ms-battery-percent: root.ms-battery-percent;
                ms-conn-label: root.ms-conn-label;
                ms-fw-label: root.ms-fw-label;
                ms-feedback-text: root.ms-feedback-text;
                ms-feedback-is-error: root.ms-feedback-is-error;
                subtab <=> root.ms-subtab;
                dirty: root.ms-dirty;

                dpi-count: root.ms-dpi-count;
                dpi-index: root.ms-dpi-index;
                dpi-values: root.ms-dpi-values;
                dpi-texts: root.ms-dpi-texts;
                polling-idx: root.ms-polling-idx;
                lod-idx: root.ms-lod-idx;
                motion-sync: root.ms-motion-sync;
                ripple-control: root.ms-ripple-control;
                linear-correction: root.ms-linear-correction;
                highspeed-mode: root.ms-highspeed;
                debounce-ms: root.ms-debounce-ms;

                scroll-idx: root.ms-scroll-idx;
                light-sleep: root.ms-light-sleep;
                deep-sleep: root.ms-deep-sleep;
                light-sleep-label: root.ms-light-sleep-label;
                deep-sleep-label: root.ms-deep-sleep-label;

                button-labels: root.ms-button-labels;
                selected-slot: root.ms-selected-slot;
                slot-title: root.ms-slot-title;
                slot-current-binding: root.ms-slot-current-binding;
                btn-category <=> root.ms-btn-category;
                btn-mouse-idx <=> root.ms-btn-mouse-idx;
                btn-mod-mask <=> root.ms-btn-mod-mask;
                btn-key-idx <=> root.ms-btn-key-idx;
                btn-media-idx <=> root.ms-btn-media-idx;
                btn-system-idx <=> root.ms-btn-system-idx;
                btn-macro-idx <=> root.ms-btn-macro-idx;
                btn-macro-mode <=> root.ms-btn-macro-mode;
                btn-macro-repeat <=> root.ms-btn-macro-repeat;
                btn-capturing-key <=> root.ms-btn-capturing-key;
                btn-left-warning: root.ms-btn-left-warning;
                key-catalog-labels: root.km-key-catalog-labels;
                media-labels: root.ms-media-labels;
                macro-names: root.macro-names;
                chatter-enabled: root.ms-chatter-enabled;
                chatter-threshold-ms: root.ms-chatter-threshold-ms;
                chatter-total: root.ms-chatter-total;
                chatter-alert-text: root.ms-chatter-alert-text;
                chatter-rows: root.ms-chatter-rows;

                dpi-count-changed(n) => { root.ms-dpi-count-changed(n); }
                dpi-stage-selected(i) => { root.ms-dpi-stage-selected(i); }
                dpi-step(i, d) => { root.ms-dpi-step(i, d); }
                dpi-text-edited(i, s) => { root.ms-dpi-text-edited(i, s); }
                dpi-text-committed(i, s) => { root.ms-dpi-text-committed(i, s); }
                polling-selected(i) => { root.ms-polling-selected(i); }
                lod-selected(i) => { root.ms-lod-selected(i); }
                sensor-toggled(i) => { root.ms-sensor-toggled(i); }
                highspeed-toggled => { root.ms-highspeed-toggled(); }
                debounce-step(d) => { root.ms-debounce-step(d); }
                debounce-set(v) => { root.ms-debounce-set(v); }
                scroll-selected(i) => { root.ms-scroll-selected(i); }
                light-sleep-selected(s) => { root.ms-light-sleep-selected(s); }
                deep-sleep-selected(s) => { root.ms-deep-sleep-selected(s); }
                apply-config-clicked => { root.ms-apply-config-clicked(); }
                sync-clicked => { root.ms-sync-clicked(); }
                start-pairing-clicked => { root.ms-start-pairing-clicked(); }

                slot-selected(i) => { root.ms-slot-selected(i); }
                btn-category-selected(c) => { root.ms-btn-category-selected(c); }
                btn-mouse-selected(i) => { root.ms-btn-mouse-selected(i); }
                btn-toggle-modifier(m) => { root.ms-btn-toggle-modifier(m); }
                btn-catalog-key-selected(i) => { root.ms-btn-catalog-key-selected(i); }
                btn-capture-key(t, c, s, a, m) => { root.ms-btn-capture-key(t, c, s, a, m); }
                btn-media-selected(i) => { root.ms-btn-media-selected(i); }
                btn-system-selected(i) => { root.ms-btn-system-selected(i); }
                btn-macro-selected(i) => { root.ms-btn-macro-selected(i); }
                btn-macro-mode-selected(m) => { root.ms-btn-macro-mode-selected(m); }
                btn-macro-repeat-step(d) => { root.ms-btn-macro-repeat-step(d); }
                open-macro-editor-clicked => {
                    root.active-tab = 0;
                    root.kb-subtab = 2;
                }
                apply-button-clicked => { root.ms-apply-button-clicked(); }
                reset-buttons-clicked => { root.ms-reset-buttons-clicked(); }
                chatter-toggle-clicked => { root.ms-chatter-toggle-clicked(); }
                chatter-threshold-step(d) => { root.ms-chatter-threshold-step(d); }
                chatter-reset-clicked => { root.ms-chatter-reset-clicked(); }
            }

            // Aba 2: Configurações & Daemon
            if (root.active-tab == 2) : SettingsView {
                daemon-connected: root.daemon-online;
                autostart: root.autostart-enabled;
                toggle-autostart => {
                    root.autostart-toggled();
                }
                restart-daemon => {
                    root.reconnect-daemon();
                }
            }
        }
    }

    // Popover HSV Contínuo sob Demanda
    if (root.hsv-popover-open) : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #00000090;

        TouchArea {
            clicked => {
                root.hsv-popover-open = false;
                root.hsv-committed();
            }
        }

        Rectangle {
            x: 260px;
            y: 356px;
            width: 244px;
            height: 230px;
            border-radius: Theme.radius-md;
            background: Theme.surface;
            border-color: Theme.border-light;
            border-width: 1px;

            // Absorve cliques dentro do popover
            TouchArea {}

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "SELETOR HSV CONTÍNUO";
                        font-family: Theme.mono-font;
                        font-size: 9px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.hex-text;
                        font-family: Theme.mono-font;
                        font-size: 9px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                // Quadrado Saturação x Valor (220x132)
                Rectangle {
                    width: 220px;
                    height: 132px;
                    border-color: Theme.border;
                    border-width: 1px;

                    Image {
                        width: 220px;
                        height: 132px;
                        source: root.hsv-sv-image;
                    }

                    // Mira sólida S/V
                    Rectangle {
                        x: root.hsv-s * 212px;
                        y: (1.0 - root.hsv-v) * 124px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        border-color: #FFFFFF;
                        border-width: 1.5px;
                        background: #00000000;
                    }

                    sv-ta := TouchArea {
                        pointer-event(ev) => {
                            if (self.pressed) {
                                root.hsv-sv-updated(
                                    clamp(self.mouse-x / 220px, 0.0, 1.0),
                                    clamp(1.0 - (self.mouse-y / 132px), 0.0, 1.0)
                                );
                            }
                            if (ev.kind == PointerEventKind.up) {
                                root.hsv-committed();
                            }
                        }
                    }
                }

                // Barra de Matiz (Hue 0..360)
                Rectangle {
                    width: 220px;
                    height: 16px;
                    border-color: Theme.border;
                    border-width: 1px;

                    Image {
                        width: 220px;
                        height: 16px;
                        source: root.hsv-hue-image;
                    }

                    Rectangle {
                        x: (root.hsv-h / 360.0) * 216px;
                        y: 0px;
                        width: 4px;
                        height: 16px;
                        border-color: #FFFFFF;
                        border-width: 1px;
                        background: #00000000;
                    }

                    hue-ta := TouchArea {
                        pointer-event(ev) => {
                            if (self.pressed) {
                                root.hsv-hue-updated(clamp((self.mouse-x / 220px) * 360.0, 0.0, 359.9));
                            }
                            if (ev.kind == PointerEventKind.up) {
                                root.hsv-committed();
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;

                    Rectangle {
                        width: 96px;
                        height: 24px;
                        border-radius: Theme.radius-sm;
                        background: root.current-color;
                        border-color: Theme.border-light;
                        border-width: 1px;
                    }

                    Rectangle {
                        width: 112px;
                        height: 24px;
                        border-radius: Theme.radius-sm;
                        background: ok-ta.has-hover ? Theme.surface-hover : Theme.surface-active;
                        border-color: Theme.border-light;
                        border-width: 1px;

                        Text {
                            text: "APLICAR & FECHAR";
                            font-family: Theme.mono-font;
                            font-size: 9px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        ok-ta := TouchArea {
                            clicked => {
                                root.hsv-popover-open = false;
                                root.apply-clicked();
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal de Enquadramento (Pan/Zoom) & Velocidade do GIF sob demanda
    if (root.gif-crop-modal-open) : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #00000090;

        TouchArea {
            clicked => {
                root.gif-crop-modal-open = false;
                root.gif-crop-applied();
            }
        }

        Rectangle {
            width: 444px;
            height: 410px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-md;
            background: Theme.surface;
            border-color: Theme.border-light;
            border-width: 1px;

            TouchArea {}

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "ENQUADRAR GIF (PAINEL 22×6)";
                        font-family: Theme.mono-font;
                        font-size: 9px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.gif-crop-info-text;
                        font-family: Theme.mono-font;
                        font-size: 9px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                // Viewport de Preview + Moldura de Recorte
                Rectangle {
                    width: 420px;
                    height: 236px;
                    border-radius: Theme.radius-sm;
                    background: Theme.background;
                    border-color: Theme.border;
                    border-width: 1px;
                    clip: true;

                    Rectangle {
                        width: root.gif-preview-w * 1px;
                        height: root.gif-preview-h * 1px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;

                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.gif-preview-image;
                            image-fit: fill;
                        }

                        // Máscaras escuras fora do recorte
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: root.gif-crop-y * parent.height;
                            background: #0000009A;
                        }
                        Rectangle {
                            x: 0px;
                            y: (root.gif-crop-y + root.gif-crop-h) * parent.height;
                            width: parent.width;
                            height: (1.0 - root.gif-crop-y - root.gif-crop-h) * parent.height;
                            background: #0000009A;
                        }
                        Rectangle {
                            x: 0px;
                            y: root.gif-crop-y * parent.height;
                            width: root.gif-crop-x * parent.width;
                            height: root.gif-crop-h * parent.height;
                            background: #0000009A;
                        }
                        Rectangle {
                            x: (root.gif-crop-x + root.gif-crop-w) * parent.width;
                            y: root.gif-crop-y * parent.height;
                            width: (1.0 - root.gif-crop-x - root.gif-crop-w) * parent.width;
                            height: root.gif-crop-h * parent.height;
                            background: #0000009A;
                        }

                        // Borda da janela selecionada
                        Rectangle {
                            x: root.gif-crop-x * parent.width;
                            y: root.gif-crop-y * parent.height;
                            width: root.gif-crop-w * parent.width;
                            height: root.gif-crop-h * parent.height;
                            border-color: Theme.status-online;
                            border-width: 1.5px;
                            background: #00000000;
                        }

                        crop-ta := TouchArea {
                            property <length> last-x: 0px;
                            property <length> last-y: 0px;

                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down) {
                                    self.last-x = self.mouse-x;
                                    self.last-y = self.mouse-y;
                                } else if (ev.kind == PointerEventKind.move && self.pressed) {
                                    root.gif-crop-pan(
                                        (self.mouse-x - self.last-x) / max(1px, parent.width),
                                        (self.mouse-y - self.last-y) / max(1px, parent.height)
                                    );
                                    self.last-x = self.mouse-x;
                                    self.last-y = self.mouse-y;
                                }
                            }

                            scroll-event(ev) => {
                                if (ev.delta-y != 0px) {
                                    root.gif-crop-zoom(ev.delta-y > 0px ? 1.12 : 0.89);
                                }
                                return EventResult.accept;
                            }
                        }
                    }
                }

                // Controles de Enquadramento e Zoom
                HorizontalLayout {
                    spacing: 6px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 6px;
                        ModalActionBtn {
                            btn-width: 158px;
                            label: "ENCAIXAR TECLADO (16:6)";
                            clicked => { root.gif-crop-fit-keyboard(); }
                        }
                        ModalActionBtn {
                            btn-width: 82px;
                            label: "100% CHEIO";
                            clicked => { root.gif-crop-reset(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        ModalActionBtn {
                            btn-width: 62px;
                            label: "ZOOM -";
                            clicked => { root.gif-crop-zoom(0.85); }
                        }
                        ModalActionBtn {
                            btn-width: 62px;
                            label: "ZOOM +";
                            clicked => { root.gif-crop-zoom(1.18); }
                        }
                    }
                }

                // Presets rápidos de Velocidade / FPS
                HorizontalLayout {
                    spacing: 4px;
                    alignment: space-between;

                    Text {
                        text: "VELOCIDADE:";
                        font-family: Theme.mono-font;
                        font-size: 9px;
                        font-weight: 700;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        for preset in [0, 2, 4, 6, 10, 15, 25, 30] : ModalActionBtn {
                            btn-width: preset == 0 ? 44px : 32px;
                            label: preset == 0 ? "AUTO" : preset;
                            active: root.gif-fps == preset;
                            clicked => { root.gif-fps-selected(preset); }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border; }

                // Rodapé
                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Arraste na imagem para mover • Scroll para zoom";
                        font-family: Theme.mono-font;
                        font-size: 8px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }

                    ModalActionBtn {
                        btn-width: 122px;
                        label: "APLICAR & FECHAR";
                        active: true;
                        clicked => {
                            root.gif-crop-modal-open = false;
                            root.gif-crop-applied();
                        }
                    }
                }
            }
        }
    }
}
