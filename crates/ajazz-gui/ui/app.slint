import { Theme } from "theme.slint";
import { Sidebar } from "sidebar.slint";
import { KeyboardView } from "keyboard_view.slint";
import { LightingControls } from "lighting_controls.slint";
import { MouseView } from "mouse_view.slint";
import { SettingsView } from "settings_view.slint";

export component MainWindow inherits Window {
    title: "AJAZZ Companion Suite";
    default-font-family: "JetBrains Mono";
    preferred-width: 980px;
    preferred-height: 640px;
    min-width: 940px;
    min-height: 600px;
    background: Theme.background;

    // Estado da aplicação
    in-out property <int> active-tab: 0;
    in-out property <color> current-color: #FF0000;
    in-out property <bool> has-color: true;
    in-out property <bool> daemon-online: true;
    in-out property <string> chattering-alert: "";

    // Callbacks para o backend Rust
    callback apply-color(color);
    callback set-mode(int);
    callback reconnect-daemon();

    HorizontalLayout {
        // Barra Lateral de Navegação
        Sidebar {
            active-tab <=> root.active-tab;
            daemon-online: root.daemon-online;
        }

        // Área Central de Conteúdo
        Rectangle {
            background: Theme.background;

            // Aba 0: Teclado AK820
            if (root.active-tab == 0) : VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: start;

                // Título e status do dispositivo
                HorizontalLayout {
                    width: 604px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 3px;
                        alignment: center;
                        Text {
                            text: "AJAZZ AK820 75% MECHANICAL KEYBOARD";
                            font-family: Theme.mono-font;
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "EVision Semiconductor (VID 0x320F / PID 0x505B) • UsagePage 0xFF1C";
                            font-family: Theme.mono-font;
                            font-size: 9px;
                            color: Theme.text-secondary;
                        }
                    }

                    Rectangle {
                        height: 24px;
                        border-radius: Theme.radius-sm;
                        background: Theme.surface;
                        border-color: Theme.border;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: Theme.status-online;
                                }
                            }

                            Text {
                                text: "CONECTADO";
                                font-family: Theme.mono-font;
                                font-size: 9px;
                                font-weight: 700;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Layout Vetorial Físico das ~82 Teclas
                KeyboardView {
                    global-led-color: root.current-color;
                    has-led: root.has-color;
                    chattering-key: root.chattering-alert;
                    key-clicked(key) => {
                        // Clique na tecla
                    }
                }

                // Painel de Controles de Iluminação
                LightingControls {
                    selected-color: root.current-color;
                    color-selected(col) => {
                        root.current-color = col;
                        root.has-color = true;
                        root.apply-color(col);
                    }
                    apply-clicked => {
                        root.apply-color(root.current-color);
                    }
                    mode-changed(mode) => {
                        root.set-mode(mode);
                    }
                }
            }

            // Aba 1: Mouse NearLink
            if (root.active-tab == 1) : MouseView { }

            // Aba 2: Configurações & Daemon
            if (root.active-tab == 2) : SettingsView {
                daemon-connected: root.daemon-online;
                restart-daemon => {
                    root.reconnect-daemon();
                }
            }
        }
    }
}
